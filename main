Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

-- Rayfield has no flags you can read back by name and no left/right groupboxes.
-- These two registries and the group wrapper below keep the element API the rest
-- of the file was written against, so every feature carries over unchanged:
--   Toggles[id].Value / :SetValue(v)
--   Options[id].Value  (sliders, dropdowns, inputs, colour pickers)
Toggles = {}
Options = {}

-- Keybinds are handled with a plain input listener rather than Rayfield's
-- CreateKeybind. LoadConfiguration replays saved flags and fires their
-- callbacks, so a keybind bound to panic unloaded the whole menu the instant
-- the script finished loading — the loading screen, then nothing.
local KEYBINDS = {}
local uiReady = false

local Window = Rayfield:CreateWindow({
    Name = ("Sulfoxium Hub — %s"):format(SUPPORTED_PLACES[game.PlaceId]),
    Icon = 0,
    LoadingTitle = "Sulfoxium Hub",
    LoadingSubtitle = SUPPORTED_PLACES[game.PlaceId],
    Theme = "Default",

    DisableRayfieldPrompts = false,
    DisableBuildWarnings = false,

    ConfigurationSaving = {
        Enabled = true,
        FolderName = CONFIG.SETTINGS_FOLDER,
        FileName = "Sulfoxium " .. tostring(game.PlaceId),
    },

    Discord = {
        Enabled = false,
        Invite = "noinvitelink",
        RememberJoins = true,
    },

    KeySystem = false,
})

local TAB_ICON = 4483362458

-- Every element is created through here. Rayfield rejects option shapes that
-- Linoria ignored, and an error while building one element used to abort the
-- whole script before the window appeared — which is why nothing loaded. A
-- failed element is now skipped and named in the console instead.
local function create(tab, kind, payload)
    local builder = tab and tab["Create" .. kind]
    if not builder then
        warn(("[Sulfoxium Hub] Rayfield has no Create%s"):format(kind))
        return nil
    end

    local ok, element = pcall(builder, tab, payload)
    if ok then return element end

    warn(("[Sulfoxium Hub] Create%s failed for %s: %s")
        :format(kind, tostring(typeof(payload) == "table" and payload.Name or payload), tostring(element)))
    return nil
end

-- Rayfield sections are plain headers: everything added after one belongs to it
-- until the next. The groupboxes are created up front but filled much later, so
-- a section is only emitted when its group first receives an element, and again
-- if another group interrupted it.
local newGroup
do
    local function increment(rounding)
        if not rounding or rounding <= 0 then return 1 end
        return 1 / (10 ^ rounding)
    end

    local function register(store, id, value)
        local entry = store[id]
        if not entry then
            entry = {}
            store[id] = entry
        end
        entry.Value = value
        return entry
    end

    function newGroup(tab, state, title)
        local group = {}

        local function open()
            if state.current ~= group then
                state.current = group
                create(tab, "Section", title)
            end
        end

        function group:AddButton(a, b)
            open()

            local text, func
            if typeof(a) == "table" then
                text, func = a.Text, a.Func
            else
                text, func = a, b
            end

            local button = create(tab, "Button", { Name = text, Callback = func })
            return {
                SetText = function(_, newText)
                    if button then pcall(function() button:Set(newText) end) end
                end,
            }
        end

        function group:AddToggle(id, info)
            open()

            local entry = register(Toggles, id, info.Default == true)

            local toggle = create(tab, "Toggle", {
                Name = info.Text,
                CurrentValue = info.Default == true,
                Flag = id,
                Callback = function(value)
                    entry.Value = value
                    if info.Callback then info.Callback(value) end
                end,
            })

            entry.SetValue = function(_, value)
                value = value == true
                if toggle then
                    pcall(function() toggle:Set(value) end)
                end
                entry.Value = value
            end

            -- Linoria hung a key picker off every toggle; only the ones that
            -- asked for a real key get a bind, and it lives in the input
            -- listener rather than in a Rayfield element.
            entry.AddKeyPicker = function(_, keyId, keyInfo)
                local default = keyInfo and keyInfo.Default
                if not default or default == "None" then return end

                KEYBINDS[default] = function()
                    entry:SetValue(not entry.Value)
                end
            end

            entry.AddColorPicker = function(_, colorId, colorInfo)
                local colorEntry = register(Options, colorId, colorInfo.Default)

                create(tab, "ColorPicker", {
                    Name = colorInfo.Title or colorId,
                    Color = colorInfo.Default,
                    Flag = colorId,
                    Callback = function(value)
                        colorEntry.Value = value
                        if colorInfo.Callback then colorInfo.Callback(value) end
                    end,
                })
            end

            return entry
        end

        function group:AddSlider(id, info)
            open()

            local entry = register(Options, id, info.Default)

            create(tab, "Slider", {
                Name = info.Text,
                Range = { info.Min, info.Max },
                Increment = increment(info.Rounding),
                Suffix = info.Suffix or "",
                CurrentValue = info.Default,
                Flag = id,
                Callback = function(value)
                    entry.Value = value
                    if info.Callback then info.Callback(value) end
                end,
            })

            return entry
        end

        function group:AddDropdown(id, info)
            open()

            local values = info.Values or {}
            local default = values[info.Default or 1]
            local entry = register(Options, id, default)

            local dropdown = create(tab, "Dropdown", {
                Name = info.Text,
                Options = values,
                CurrentOption = default and { default } or {},
                MultipleOptions = info.Multi == true,
                Flag = id,
                Callback = function(selection)
                    -- Rayfield hands back a table even for single selection.
                    local value = typeof(selection) == "table" and selection[1] or selection
                    entry.Value = value
                    if info.Callback then info.Callback(value) end
                end,
            })

            entry.SetValues = function(_, newValues)
                if not dropdown then return end
                if pcall(function() dropdown:Refresh(newValues) end) then return end
                pcall(function() dropdown:Refresh(newValues, {}) end)
            end

            return entry
        end

        function group:AddInput(id, info)
            open()

            local entry = register(Options, id, info.Default or "")

            create(tab, "Input", {
                Name = info.Text,
                CurrentValue = info.Default or "",
                PlaceholderText = info.Placeholder or "",
                Numeric = false,
                RemoveTextAfterFocusLost = false,
                Flag = id,
                Callback = function(text)
                    entry.Value = text
                    if info.Callback then info.Callback(text) end
                end,
            })

            return entry
        end

        function group:AddLabel(text)
            open()

            local label = create(tab, "Label", text)
            return {
                SetText = function(_, newText)
                    if label then pcall(function() label:Set(newText) end) end
                end,
            }
        end

        return group
    end
end

local function newTab(name)
    local ok, tab = pcall(function()
        return Window:CreateTab(name, TAB_ICON)
    end)
    if not ok or not tab then
        warn(("[Sulfoxium Hub] CreateTab failed for %s: %s"):format(name, tostring(tab)))
        tab = Window:CreateTab(name)
    end

    local state = { current = nil }
    return {
        AddLeftGroupbox  = function(_, title) return newGroup(tab, state, title) end,
        AddRightGroupbox = function(_, title) return newGroup(tab, state, title) end,
        raw = tab,
    }
end

local Tabs = {
    Main     = newTab("Main"),
    Visuals  = newTab("Visuals"),
    Night1   = newTab("Night 1"),
    Night2   = newTab("Night 2"),
    Night3   = newTab("Night 3"),
    Bunker   = newTab("The Bunker"),
    Server   = newTab("Server"),
    Settings = newTab("UI Settings"),
}

local function Button(group, text, tooltip, callback)
    local wrapped = safe(callback, text)
    local ok, btn = pcall(function()
        return group:AddButton({ Text = text, Func = wrapped, Tooltip = tooltip })
    end)
    if ok then return btn end
    return group:AddButton(text, wrapped)
end

local ToggleButtons = { list = {}, groups = {} }

local function setButtonText(btn, text)
    if typeof(btn) ~= "table" then return false end
    if pcall(function() btn:SetText(text) end) then return true end
    for _, value in pairs(btn) do
        if typeof(value) == "Instance" and (value:IsA("TextLabel") or value:IsA("TextButton")) then
            if pcall(function() value.Text = text end) then return true end
        end
    end
    return false
end

local function clearToggleGroup(name, except)
    local bucket = name and ToggleButtons.groups[name]
    if not bucket then return end
    for _, other in ipairs(bucket) do
        if other ~= except and other.state then
            other.state = false
            other.refresh()
        end
    end
end

-- Press once to apply, press again to undo. `apply` may return false to say
-- "nothing happened", in which case the button stays off.
local function ToggleButton(group, text, tooltip, apply, revert, options)
    options = options or {}

    local handle = {
        text  = text,
        state = options.default == true,
        busy  = false,
    }

    function handle.refresh()
        setButtonText(handle.button, handle.state and ("[ON] " .. text) or text)
    end

    function handle:Set(state)
        state = state == true
        if handle.state == state then return end
        handle.state = state
        handle.refresh()
    end

    function handle:Revert()
        if not handle.state or handle.busy then return end
        handle.busy = true
        local ok, err = pcall(revert)
        handle.busy = false
        handle.state = false
        handle.refresh()
        if not ok then
            warn(("[Sulfoxium Hub] %s undo failed: %s"):format(text, tostring(err)))
        end
    end

    handle.button = Button(group, text, tooltip, function()
        if handle.busy then return end
        handle.busy = true

        local ok, err = pcall(function()
            if handle.state then
                revert()
                handle.state = false
            else
                clearToggleGroup(handle.groupName, handle)
                if apply() ~= false then
                    handle.state = true
                end
            end
        end)

        handle.busy = false
        handle.refresh()
        if not ok then error(err, 0) end
    end)

    handle.keepOnReset = options.keepOnReset == true

    if options.group then
        local bucket = ToggleButtons.groups[options.group]
        if not bucket then
            bucket = {}
            ToggleButtons.groups[options.group] = bucket
        end
        table.insert(bucket, handle)
        handle.groupName = options.group
    end

    table.insert(ToggleButtons.list, handle)
    handle.refresh()
    return handle
end

local function revertToggleButtons()
    for i = #ToggleButtons.list, 1, -1 do
        local handle = ToggleButtons.list[i]
        if handle.state and not handle.keepOnReset then
            pcall(function() handle:Revert() end)
        end
    end
end

local function Toggle(group, id, info, defaultKey)
    local toggle = group:AddToggle(id, info)
    pcall(function()
        toggle:AddKeyPicker(id .. "Key", {
            Default = defaultKey or "None",
            SyncToggleState = true,
            Mode = "Toggle",
            Text = info.Text,
            NoUI = false,
        })
    end)
    return toggle
end

local function setLabel(label, text)
    if not label then return end
    pcall(function() label:SetText(text) end)
end

