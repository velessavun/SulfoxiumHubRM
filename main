-- Interface ------------------------------------------------------------------
-- Built here rather than pulled from a library. Everything below exposes the
-- same element API the rest of the file was already written against, so no
-- feature code changes:
--   Toggles[id].Value / :SetValue(v)   Options[id].Value
--   group:AddButton / AddToggle / AddSlider / AddDropdown / AddInput / AddLabel
Toggles = {}
Options = {}

-- Keybinds are a plain input listener, not UI elements.
local KEYBINDS = {}
local uiReady = false

local SCRIPT_VERSION = "v3.0"

local newTab
do
    local TweenService = game:GetService("TweenService")
    local Stats = game:GetService("Stats")

    local THEME = {
        black   = Color3.fromRGB(24, 12, 14),   -- the pane behind everything
        panel   = Color3.fromRGB(38, 17, 20),   -- sidebar and content plates
        row     = Color3.fromRGB(86, 26, 30),   -- maroon control plates
        rowLit  = Color3.fromRGB(120, 32, 36),  -- maroon, hovered
        accent  = Color3.fromRGB(205, 45, 48),  -- lettering and fills
        border  = Color3.fromRGB(190, 40, 42),  -- the outline around it all
        tabOn   = Color3.fromRGB(170, 38, 42),  -- the tab you are on
        deep    = Color3.fromRGB(96, 26, 30),
        text    = Color3.fromRGB(240, 235, 235),
        dim     = Color3.fromRGB(132, 126, 126),
    }

    local WINDOW = Vector2.new(800, 470)
    local SIDEBAR = 200

    local function make(class, props, parent)
        local inst = Instance.new(class)
        for key, value in pairs(props or {}) do
            inst[key] = value
        end
        if parent then inst.Parent = parent end
        return inst
    end

    local function round(inst, radius)
        make("UICorner", { CornerRadius = UDim.new(0, radius or 8) }, inst)
        return inst
    end

    local function edge(inst, color, transparency)
        make("UIStroke", {
            Color = color or THEME.deep,
            Transparency = transparency or 0.4,
            Thickness = 1,
        }, inst)
        return inst
    end

    local function padding(inst, amount)
        make("UIPadding", {
            PaddingLeft = UDim.new(0, amount),
            PaddingRight = UDim.new(0, amount),
            PaddingTop = UDim.new(0, amount),
            PaddingBottom = UDim.new(0, amount),
        }, inst)
        return inst
    end

    local function tween(inst, time, props)
        local ok, animation = pcall(function()
            return TweenService:Create(inst, TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
        end)
        if ok and animation then animation:Play() end
        return animation
    end

    -- Screen ------------------------------------------------------------------

    local screen = make("ScreenGui", {
        Name = "Sulfoxium Hub",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        DisplayOrder = 999,
        IgnoreGuiInset = true,
    }, hiddenUI)

    -- Readouts down the right edge: version, executor, ping, fps top to bottom.
    local hud = make("Frame", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -14, 0.5, 0),
        Size = UDim2.new(0, 198, 0, 30 + 4 * 51 + 4 * 10),
        BackgroundTransparency = 1,
    }, screen)

    make("UIListLayout", {
        Padding = UDim.new(0, 10),
        SortOrder = Enum.SortOrder.LayoutOrder,
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
    }, hud)

    local function hudBox(order)
        -- No stroke on these: they read cleaner as plain plates.
        local box = round(make("Frame", {
            Size = UDim2.new(1, 0, 0, 51),
            BackgroundColor3 = THEME.row,
            BackgroundTransparency = 0.25,
            LayoutOrder = order,
        }, hud), 12)

        return make("TextLabel", {
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            Font = Enum.Font.GothamBold,
            TextSize = 21,
            TextColor3 = THEME.accent,
            Text = "--",
        }, box)
    end

    local hudTitle = make("TextLabel", {
        Size = UDim2.new(1, 0, 0, 30),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        TextSize = 22,
        TextColor3 = THEME.text,
        Text = "SULFOXIUM",
        LayoutOrder = 0,
    }, hud)

    make("TextLabel", {
        AnchorPoint = Vector2.new(0, 0),
        Position = UDim2.new(1, 4, 0, 0),
        Size = UDim2.fromOffset(60, 30),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        TextSize = 22,
        TextColor3 = THEME.accent,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = "HUB",
    }, hudTitle)

    local versionLabel  = hudBox(1)
    local executorLabel = hudBox(2)
    local pingLabel     = hudBox(3)
    local fpsLabel      = hudBox(4)

    versionLabel.Text = SCRIPT_VERSION

    do
        local name = "Unknown"
        local ok, found = pcall(function()
            if identifyexecutor then return identifyexecutor() end
            if getexecutorname then return getexecutorname() end
            return nil
        end)
        if ok and typeof(found) == "string" and found ~= "" then name = found end
        executorLabel.Text = name
    end

