Button(ServerGroup, "Server Hop", "Finds another public server and joins it", function()
    notify("Looking for a server...", 4)
    local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100"):format(game.PlaceId)
    local ok, body = pcall(function() return game:HttpGet(url) end)
    if not ok then return notify("Could not reach the Roblox server list.") end

    local decoded
    ok, decoded = pcall(function() return HttpService:JSONDecode(body) end)
    if not ok or typeof(decoded) ~= "table" or typeof(decoded.data) ~= "table" then
        return notify("Server list response was unreadable.")
    end

    local candidates = {}
    for _, server in ipairs(decoded.data) do
        if server.id ~= game.JobId and server.playing and server.maxPlayers
            and server.playing < server.maxPlayers then
            table.insert(candidates, server.id)
        end
    end

    if #candidates == 0 then return notify("No other servers with space right now.") end
    local pick = candidates[math.random(1, #candidates)]
    notify("Hopping...", 4)
    TeleportService:TeleportToPlaceInstance(game.PlaceId, pick, LocalPlayer)
end)

local threatLabel = WatchGroup:AddLabel("Nearest threat: --")

Toggle(WatchGroup, "ThreatWarning", {
    Text = "Proximity Warning",
    Default = false,
    Tooltip = "Notifies when a tracked threat gets close (needs matching ESP category on)",
})

WatchGroup:AddSlider("ThreatRange", {
    Text = "Warning range",
    Default = 40,
    Min = 10,
    Max = 200,
    Rounding = 0,
    Suffix = " studs",
})

do
    local accumulator, lastWarn = 0, 0
    Master:Add(RunService.Heartbeat:Connect(function(dt)
        accumulator += dt
        if accumulator < CONFIG.THREAT_INTERVAL then return end
        accumulator = 0

        if nearestThreat.name then
            setLabel(threatLabel, ("Nearest threat: %s (%dm)"):format(nearestThreat.name, math.floor(nearestThreat.distance)))
            if tog("ThreatWarning") and nearestThreat.distance <= opt("ThreatRange", 40) then
                if tick() - lastWarn > 4 then
                    lastWarn = tick()
                    notify(("%s is %dm away!"):format(nearestThreat.name, math.floor(nearestThreat.distance)), 3)
                end
            end
        else
            setLabel(threatLabel, "Nearest threat: none tracked")
        end
    end))
end

-- Scoped: nothing here is used outside the Night 1 tab.
do
    local WOODPILE_CF  = CFrame.new(-27.149, 8.7, -118.611)
    local FIREPLACE_CF = CFrame.new(-45.113, 7.84, -60.241)
    local GENERATOR_CF = CFrame.new(-76.039, 4.675, -133.78)

    local function woodPileDetector()
        local pile = Workspace:FindFirstChild("WoodPile")
        local detector = pile and pile:FindFirstChild("Detector")
        if not detector then return nil end
        detector.CanCollide = false
        return detector:FindFirstChildOfClass("ClickDetector")
    end

    local function grabAt(destination, trigger, label)
        local before = toolSnapshot()
        local held = nil

        local done = runAt(destination, function()
            interact(trigger)
        end, function()
            held = newToolSince(before)
            return held ~= nil
        end)

        if done then
            notify(("%s picked up."):format(label))
        else
            notify(("%s did not register a pickup — check you are close enough."):format(label), 5)
        end
        return done, held
    end

    Button(N1ActGroup, "Grab Wood", "Teleports to the pile and returns the instant the log is in hand", function()
        local click = woodPileDetector()
        if not click then return notify("Wood pile not found.") end
        pushPosition()
        grabAt(WOODPILE_CF, click, "Wood")
    end)

    Button(N1ActGroup, "Refill Fireplace", "Grabs wood, delivers it, returns the instant it is consumed", function()
        local click = woodPileDetector()
        if not click then return notify("Wood pile not found.") end

        local char, root = Char.require()
        local origin = root.CFrame
        local before = toolSnapshot()
        pushPosition()
        Collision.acquire("fireplace")

        local delivered = false
        local ok, err = pcall(function()
            char:PivotTo(WOODPILE_CF)
            zeroVelocity(root)

            local log
            local grabbed = actUntil(function()
                interact(click)
            end, function()
                log = newToolSince(before)
                return log ~= nil
            end)

            if not grabbed then return end

            char:PivotTo(FIREPLACE_CF)
            zeroVelocity(root)

            delivered = actUntil(function()
                local fireplace = Workspace:FindFirstChild("Fireplace")
                if fireplace then interact(fireplace) end
            end, function()
                return toolGone(log)
            end)
        end)

        char:PivotTo(origin)
        zeroVelocity(root)
        Collision.release("fireplace")

        if not ok then error(err, 0) end
        notify(delivered and "Fireplace refilled." or "Wood was not consumed — you may already be full.", 5)
    end)

    Button(N1ActGroup, "Grab JerryCan", "Returns the instant the can is in hand", function()
        local shack = Workspace:FindFirstChild("Shack")
        local can = shack and shack:FindFirstChild("JerryCan")
        local click = can and can:FindFirstChildOfClass("ClickDetector")
        if not click then return notify("JerryCan not found.") end
        pushPosition()
        grabAt(GENERATOR_CF, click, "JerryCan")
    end)

    Button(N1ActGroup, "Refill Generator", "Grabs the can, fuels the generator, returns on completion", function()
        local shack = Workspace:FindFirstChild("Shack")
        if not shack then return notify("Shack not found.") end
        local can = shack:FindFirstChild("JerryCan")
        local gen = shack:FindFirstChild("Generator")
        local canClick = can and can:FindFirstChildOfClass("ClickDetector")
        local genClick = gen and gen:FindFirstChildOfClass("ClickDetector")
        if not (canClick and genClick) then return notify("Generator or can not found.") end

        local before = toolSnapshot()
        pushPosition()

        local fuelled = false
        local stage = 1
        local fuel

        runAt(GENERATOR_CF, function()
            if stage == 1 then
                Exec.clickDetector(canClick)
                fuel = newToolSince(before)
                if fuel then stage = 2 end
            else
                Exec.clickDetector(genClick)
            end
        end, function()
            if stage == 1 then return false end
            fuelled = toolGone(fuel)
            return fuelled
        end)

        notify(fuelled and "Generator refilled." or "Could not confirm the refill — try again closer.", 5)
    end)

    Toggle(N1ActGroup, "AutoFireplace", {
        Text = "Auto Fireplace",
        Default = false,
        Tooltip = "Keeps the fireplace topped up on a timer",
        Callback = function(state)
            if not state then return end
            spawnSafe(function()
                while tog("AutoFireplace") do
                    local click = woodPileDetector()
                    if click then
                        local char, root = Char.require()
                        local origin = root.CFrame
                        local before = toolSnapshot()
                        Collision.acquire("autoFire")
                        pcall(function()
                            char:PivotTo(WOODPILE_CF)
                            zeroVelocity(root)

                            local log
                            local grabbed = actUntil(function()
                                interact(click)
                            end, function()
                                log = newToolSince(before)
                                return log ~= nil
                            end, 3)

                            if grabbed then
                                char:PivotTo(FIREPLACE_CF)
                                zeroVelocity(root)
                                actUntil(function()
                                    local fireplace = Workspace:FindFirstChild("Fireplace")
                                    if fireplace then interact(fireplace) end
                                end, function()
                                    return toolGone(log)
                                end, 3)
                            end
                        end)
                        char:PivotTo(origin)
                        zeroVelocity(root)
                        Collision.release("autoFire")
                    end
                    task.wait(opt("AutoFireplaceDelay", 45))
                end
            end, "Auto fireplace")
        end,
    })

    N1ActGroup:AddSlider("AutoFireplaceDelay", {
        Text = "Fireplace interval",
        Default = 45,
        Min = 10,
        Max = 180,
        Rounding = 0,
        Suffix = "s",
    })

    local upgradeFrameState

    ToggleButton(N1ActGroup, "Open Upgrade Frame",
        "Press again to close it again",
        function()
            local gui = LocalPlayer:FindFirstChild("PlayerGui")
            local dialogue = gui and gui:FindFirstChild("DialogueUI")
            local frame = dialogue and dialogue:FindFirstChild("UpgradeFrame")
            if not frame then
                notify("UpgradeFrame not found.")
                return false
            end
            upgradeFrameState = { inst = frame, visible = frame.Visible, position = frame.Position }
            frame.Visible = true
            frame.Position = UDim2.new(0.499, 0, 0.5, 0)
            notify("Upgrade frame opened.")
        end,
        function()
            local saved = upgradeFrameState
            upgradeFrameState = nil
            if saved and saved.inst.Parent then
                pcall(function()
                    saved.inst.Visible = saved.visible
                    saved.inst.Position = saved.position
                end)
            end
            notify("Upgrade frame closed.")
        end)

    local gamblerCupColors = {}

    ToggleButton(N1ActGroup, "Mark Gambler Cups",
        "Colours the cups so the shell game is readable — press again to restore their colours",
        function()
            local assets = ReplicatedStorage:FindFirstChild("Assets")
            local gambler = (assets and assets:FindFirstChild("Gambler")) or Workspace:FindFirstChild("Gambler")
            local cups = gambler and gambler:FindFirstChild("Cups")
            if not cups then
                notify("Gambler cups not found.")
                return false
            end

            local one, three = cups:FindFirstChild("1"), cups:FindFirstChild("3")
            if one then
                table.insert(gamblerCupColors, { inst = one, color = one.BrickColor })
                one.BrickColor = BrickColor.new("Really red")
            end
            if three then
                table.insert(gamblerCupColors, { inst = three, color = three.BrickColor })
                three.BrickColor = BrickColor.new("Lime green")
            end
            notify("Cups marked.")
        end,
        function()
            for _, entry in ipairs(gamblerCupColors) do
                if entry.inst.Parent then
                    pcall(function() entry.inst.BrickColor = entry.color end)
                end
            end
            gamblerCupColors = {}
            notify("Cup colours restored.")
        end)

    local cameraRoutineBusy = false
    local CAMERA_TARGETS = {
        { cf = CFrame.new(-51.5, 18, -89),   lookBack = false },
        { cf = CFrame.new(-14.75, 18, -120), lookBack = true },
        { cf = CFrame.new(-18.75, 18, 27),   lookBack = false },
    }

    Button(N1ActGroup, "Fix All Cameras", "Visits each camera and clicks it", function()
        if cameraRoutineBusy then
            return notify("Camera routine already running.")
        end
        if not Exec.hasMouse then
            notify("Warning: mousemoverel unsupported — cursor lock skipped.", 5)
        end

        cameraRoutineBusy = true
        local routine = Janitor.new()
        Collision.acquire("cameraRoutine")

        local ok, err = pcall(function()
            local _, root = Char.require()
            local hum = Char.humanoid()
            local origin = root.CFrame
            local camera = Workspace.CurrentCamera

            if Exec.hasMouse then
                routine:Add(RunService.RenderStepped:Connect(function()
                    local viewport = camera.ViewportSize
                    local mouse = UserInputService:GetMouseLocation()
                    Exec.mouseMoveRel(
                        (viewport.X / 2) - mouse.X,
                        (viewport.Y / 2) - 125 - mouse.Y
                    )
                end))
            end

            if hum then hum.PlatformStand = true end

            local function frameCamera(position, lookBack)
                local offset = lookBack and Vector3.new(0, 3, 10) or Vector3.new(0, 3, -10)
                camera.CFrame = CFrame.lookAt(position + offset, position + Vector3.new(0, 2, 0))
            end

            local function glideTo(targetCF)
                local start = root.Position
                local finish = targetCF.Position
                local duration = math.clamp((finish - start).Magnitude / 290, 0.05, 0.5)
                local elapsed = 0

                while elapsed < duration do
                    elapsed += RunService.RenderStepped:Wait()
                    local alpha = math.clamp(elapsed / duration, 0, 1)
                    root.CFrame = CFrame.new(start:Lerp(finish, alpha))
                    zeroVelocity(root)
                    frameCamera(root.Position, false)
                end

                root.CFrame = targetCF
                zeroVelocity(root)
            end

            for _, target in ipairs(CAMERA_TARGETS) do
                glideTo(target.cf)

                local timer = 0
                while timer < 0.08 do
                    timer += RunService.RenderStepped:Wait()
                    root.CFrame = target.cf
                    zeroVelocity(root)
                    frameCamera(root.Position, target.lookBack)

                    local mouse = UserInputService:GetMouseLocation()
                    VirtualInputManager:SendMouseButtonEvent(mouse.X, mouse.Y, 0, true, game, 0)
                    task.wait(0.005)
                    VirtualInputManager:SendMouseButtonEvent(mouse.X, mouse.Y, 0, false, game, 0)
                    task.wait(0.01)
                end

                if target.lookBack then
                    frameCamera(root.Position, false)
                end
            end

            if hum then hum.PlatformStand = false end
            root.CFrame = origin
            zeroVelocity(root)
        end)

        routine:Clean()
        Collision.release("cameraRoutine")

        local hum = Char.humanoid()
        if hum then hum.PlatformStand = false end

        cameraRoutineBusy = false
        if not ok then error(err, 0) end
        notify("All cameras fixed.")
    end)
end

