-- Categories tagged with a tab live in that tab, so this only covers the ones
-- shown here plus tracers. Anything already on means the press turns all off.
Button(ESPGroup, "Toggle All ESP", "Turns every ESP in this tab and tracers on, or all off", function()
    local anyOn = tog("ESPTracers")

    if not anyOn then
        for _, cat in ipairs(ESP_CATEGORIES) do
            if not cat.tab and tog("ESP_" .. cat.key) then
                anyOn = true
                break
            end
        end
    end

    local target = not anyOn
    for _, cat in ipairs(ESP_CATEGORIES) do
        if not cat.tab then
            setToggle("ESP_" .. cat.key, target)
        end
    end
    setToggle("ESPTracers", target)

    notify(target and "All ESP enabled." or "All ESP disabled.")
end)

