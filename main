local BUNKER_FUEL_NAMES = { JerryCan = true, Gasoline = true, Fuel = true }
local BUNKER_GEN_NAMES  = { Generator = true, Gen = true }
local BUNKER_VENT_NAMES = { Ventilation = true, Vent = true, Debris = true }

local FUEL_REMOTE_NAMES = { "Refuel", "FillGenerator", "UseFuel", "AddFuel", "FuelGenerator" }

local function fireGenerators(generators, fuelTool)
    local fired = false

    for _, gen in ipairs(generators) do
        if interact(gen) then fired = true end
    end

    if fuelTool and fuelTool.Parent then
        pcall(function() fuelTool:Activate() end)
        fired = true
    end

    local folder = remotes()
    if folder then
        for _, name in ipairs(FUEL_REMOTE_NAMES) do
            local remote = folder:FindFirstChild(name)
            if remote and remote:IsA("RemoteEvent") then
                pcall(function() remote:FireServer() end)
                fired = true
            end
        end
    end

    return fired
end

local function isCarried(inst)
    if inst:FindFirstAncestorOfClass("Backpack") then return true end
    local model = inst:FindFirstAncestorOfClass("Model")
    while model do
        if model:FindFirstChildOfClass("Humanoid") then return true end
        model = model:FindFirstAncestorOfClass("Model")
    end
    return false
end

local function fuelInInventory()
    local containers = { Char.get(), LocalPlayer:FindFirstChildOfClass("Backpack") }
    for _, container in ipairs(containers) do
        if container then
            for _, item in ipairs(container:GetChildren()) do
                if item:IsA("Tool") and BUNKER_FUEL_NAMES[item.Name] then return item end
            end
        end
    end
    return nil
end

local usedCans = setmetatable({}, { __mode = "k" })

local function canCandidates()
    local root = Char.root()
    local origin = root and root.Position or Vector3.zero
    local list = {}

    for _, inst in ipairs(Workspace:GetDescendants()) do
        if BUNKER_FUEL_NAMES[inst.Name] and not usedCans[inst] and not isCarried(inst) then
            local part = mainPartOf(inst)
            if part then
                table.insert(list, {
                    inst = inst,
                    part = part,
                    distance = (part.Position - origin).Magnitude,
                })
            end
        end
    end

    return list
end

local function pickCan()
    local list = canCandidates()

    if #list == 0 then
        usedCans = setmetatable({}, { __mode = "k" })
        list = canCandidates()
    end
    if #list == 0 then return nil end

    table.sort(list, function(a, b) return a.distance < b.distance end)
    return list[1]
end

local function findNamedGenerator()
    local direct = Workspace:FindFirstChild("Generator")
    if direct then return direct end
    for _, inst in ipairs(Workspace:GetDescendants()) do
        if inst.Name == "Generator" and (inst:IsA("Model") or inst:IsA("BasePart")) then
            return inst
        end
    end
    return nil
end

-- Exactly at the centre of the generator, not hovering over it: standing on top
-- put the character out of range of whatever the refill actually reacts to.
local function generatorSpotCF(gen)
    local part = mainPartOf(gen)
    if not part then return nil, nil end
    return CFrame.new(part.Position), part
end

local refillBusy = false

local function refillGeneratorRoutine()
    if refillBusy then
        return false, "Refill already running."
    end

    local character, root = Char.require()
    local generator = findNamedGenerator()
    if not generator then
        return false, "No object named 'Generator' found in Workspace."
    end

    local generatorCF, generatorPart = generatorSpotCF(generator)
    if not generatorCF then
        return false, ("Found %s but it contains no BasePart to stand on."):format(generator:GetFullName())
    end

    local origin = root.CFrame
    local timeout = CONFIG.REFILL_TIMEOUT

    refillBusy = true
    Collision.acquire("refill")

    local stage, detail = "start", nil

    local tried = 0

    local ok, err = pcall(function()
        local fuel = fuelInInventory()

        while not fuel and tried < CONFIG.REFILL_CAN_ATTEMPTS do
            local candidate = pickCan()
            if not candidate then
                stage = "nocan"
                return
            end

            tried += 1
            usedCans[candidate.inst] = true

            local canPosition = candidate.part.Position
            local before = toolSnapshot()

            character:PivotTo(CFrame.new(canPosition))
            zeroVelocity(root)

            actUntil(function()
                local part = candidate.part
                local livePosition = (part and part.Parent) and part.Position or canPosition
                root.CFrame = CFrame.new(livePosition)
                zeroVelocity(root)
                interact(candidate.inst)
            end, function()
                fuel = fuelInInventory() or newToolSince(before)
                return fuel ~= nil
            end, timeout)
        end

        if not fuel then
            stage = "nopickup"
            return
        end

        local humanoid = Char.humanoid()
        if humanoid and fuel and fuel.Parent ~= character then
            pcall(function() humanoid:EquipTool(fuel) end)
            waitUntil(function() return fuel.Parent == character end, 1)
        end

        character:PivotTo(generatorCF)
        zeroVelocity(root)

        local emptied = actUntil(function()
            root.CFrame = CFrame.new(generatorPart.Position)
            zeroVelocity(root)
            fireGenerators({ generator }, fuelInInventory())
        end, function()
            return fuelInInventory() == nil
        end, timeout)

        stage = emptied and "done" or "notconsumed"
        detail = ("%s at %d, %d, %d"):format(
            generator:GetFullName(),
            generatorPart.Position.X,
            generatorPart.Position.Y,
            generatorPart.Position.Z
        )
    end)

    if root.Parent then
        root.CFrame = origin
        zeroVelocity(root)
    end
    Collision.release("refill")
    refillBusy = false

    if not ok then error(err, 0) end

    if stage == "done" then
        local left = #canCandidates()
        return true, ("Generator refilled — %d can%s left in the map."):format(left, left == 1 and "" or "s")
    elseif stage == "nocan" then
        return false, "No JerryCan left in the map that I have not already taken."
    elseif stage == "nopickup" then
        return false, ("Visited %d can spot(s), none gave a pickup — they were probably already looted."):format(tried)
    elseif stage == "notconsumed" then
        return false, ("Reached %s but the can was never consumed."):format(detail or "the generator")
    end
    return false, "Refill did not complete."
end

-- Read-only readout, refreshed on a timer. Scoped so its locals are released.
do
    local statusLabel = BunkerActGroup:AddLabel("Generator: checking...")

    local FUEL_WORDS  = { "fuel", "power", "charge", "energy", "gas" }
    local STATE_WORDS = { "on", "running", "active", "enabled", "started" }

    local function matchesAny(lower, words)
        for _, word in ipairs(words) do
            if lower:find(word, 1, true) then return true end
        end
        return false
    end

    local cached, nextSearch, accumulator = nil, 0, 0

    -- Finding it walks the whole Workspace, so once found it is kept, and a
    -- fruitless search is not repeated every tick.
    local function generator()
        if cached and cached.Parent then return cached end
        if os.clock() < nextSearch then return nil end
        nextSearch = os.clock() + 5
        cached = findNamedGenerator()
        return cached
    end

    -- The generator's fuel could be an attribute or a value object and the name
    -- varies, so anything numeric that reads like fuel counts, and anything
    -- boolean that reads like a running flag gives the on/off state.
    local function readStatus(gen)
        local fuel, fuelMax, running

        local function consider(name, value)
            local lower = name:lower()
            if typeof(value) == "number" then
                if lower:find("max", 1, true) and matchesAny(lower, FUEL_WORDS) then
                    fuelMax = fuelMax or value
                elseif not fuel and matchesAny(lower, FUEL_WORDS) then
                    fuel = value
                end
            elseif typeof(value) == "boolean" and running == nil and matchesAny(lower, STATE_WORDS) then
                running = value
            end
        end

        for name, value in pairs(gen:GetAttributes()) do
            consider(name, value)
        end
        for _, child in ipairs(gen:GetDescendants()) do
            if child:IsA("ValueBase") then
                consider(child.Name, child.Value)
            end
        end

        return fuel, fuelMax, running
    end

    -- Games usually already draw the fuel somewhere on the generator itself, so
    -- if there is no number to read, its own readout is the next best source.
    local function readLabelText(gen)
        local fallback

        for _, child in ipairs(gen:GetDescendants()) do
            if (child:IsA("TextLabel") or child:IsA("TextButton")) and child.Text:find("%d") then
                local text = child.Text
                local lower = text:lower()

                -- A distance readout is not fuel: "34m away", "12 studs", "34m".
                local isDistance = lower:find("away", 1, true)
                    or lower:find("stud", 1, true)
                    or lower:match("^%s*%d+%s*m%s*$")

                if not isDistance then
                    -- Anything naming fuel, or shaped like 47/100 or 47%, wins
                    -- outright; otherwise keep the first number seen as a guess.
                    if lower:find("fuel", 1, true) or text:find("/") or text:find("%%") then
                        return text
                    end
                    fallback = fallback or text
                end
            end
        end

        return fallback
    end

    local dumped = false

    -- Printed once so the real names are known if nothing above matched.
    local function dumpSources(gen)
        if dumped then return end
        dumped = true

        warn("[Sulfoxium Hub] no fuel value found on " .. gen:GetFullName() .. ". It holds:")
        for name, value in pairs(gen:GetAttributes()) do
            warn(("    attribute %s = %s (%s)"):format(name, tostring(value), typeof(value)))
        end
        for _, child in ipairs(gen:GetDescendants()) do
            if child:IsA("ValueBase") then
                warn(("    %s %s = %s"):format(child.ClassName, child.Name, tostring(child.Value)))
            elseif child:IsA("TextLabel") or child:IsA("TextButton") then
                warn(("    %s %s text = %s"):format(child.ClassName, child.Name, tostring(child.Text)))
            end
        end
    end

    local function statusText()
        local gen = generator()
        if not gen then return "Generator: not found" end

        local fuel, fuelMax, running = readStatus(gen)

        -- The number itself, not a percentage: 47/100 says how much is left and
        -- how far off empty you are at a glance.
        local reading
        if fuel then
            local maximum = fuelMax
            if not maximum or maximum <= 0 then
                -- No maximum is exposed anywhere on the generator, and the
                -- game's fuel runs to 100, so that is the scale shown. It is
                -- raised if a reading ever goes past it rather than printing
                -- something like 150/100.
                maximum = math.max(100, fuel)
            end

            reading = ("%d/%d fuel"):format(math.floor(fuel + 0.5), math.floor(maximum + 0.5))
        else
            reading = readLabelText(gen)
            if not reading then
                dumpSources(gen)
                return "Generator: found, but no fuel value to read"
            end
        end

        if running ~= nil then
            reading = reading .. (running and "  |  running" or "  |  off")
        end

        return "Generator: " .. reading
    end

    -- Ten times a second. Cheap because the generator is cached and only its own
    -- descendants are read, never the Workspace.
    Master:Add(RunService.Heartbeat:Connect(function(dt)
        accumulator += dt
        if accumulator < 0.1 then return end
        accumulator = 0
        setLabel(statusLabel, statusText())
    end))
end

Button(BunkerActGroup, "Refill Generator", "TP to a can, grab it, TP to the Generator, refill, return when the can is gone", function()
    pushPosition()
    local ok, message = refillGeneratorRoutine()
    notify(message, ok and 4 or 6)
end)

local function findVents()
    local vents = {}
    for _, inst in ipairs(Workspace:GetDescendants()) do
        if BUNKER_VENT_NAMES[inst.Name] then
            table.insert(vents, inst)
        end
    end
    return vents
end

Button(BunkerActGroup, "Remove BunkerRat", "Fires the KillPlayer remote", function()
    if fireRemote("KillPlayer") then notify("BunkerRat removed.") end
end)

Button(BunkerActGroup, "Make Sky Pure White", "Strips the sky and all shadows for maximum brightness", function()
    makeSkyPureWhite()
end)

Button(BunkerActGroup, "Fix Ventilation", "Teleports to the vent and snaps back the frame it is fixed", function()
    local vents = findVents()
    if #vents == 0 then
        return notify("No ventilation object found — nothing to fix.")
    end

    local triggers = {}
    for _, vent in ipairs(vents) do
        for _, trigger in ipairs(collectTriggers(vent)) do
            table.insert(triggers, trigger)
        end
    end

    if #triggers == 0 then
        return notify("Vent found but it has no prompt or click detector to fire.")
    end

    local startingLive = triggersLive(triggers)
    if startingLive == 0 then
        return notify("Ventilation is already fixed.")
    end

    pushPosition()

    local fixed, attempts = runAt(BUNKER_SPOTS[3].cf, function()
        for _, trigger in ipairs(triggers) do
            interact(trigger)
        end
    end, function()
        for _, vent in ipairs(vents) do
            if vent.Parent then
                return triggersLive(triggers) == 0
            end
        end
        return true
    end, opt("VentTimeout", 6))

    -- Success is silent; only a vent that would not go quiet is worth saying.
    if not fixed then
        notify(("Vent still has %d live trigger(s) after %ds — returned anyway.")
            :format(triggersLive(triggers), opt("VentTimeout", 6)), 6)
    end
end)

BunkerActGroup:AddSlider("VentTimeout", {
    Text = "Vent give-up time",
    Default = 6,
    Min = 1,
    Max = 20,
    Rounding = 0,
    Suffix = "s",
})

-- Night 3 --------------------------------------------------------------------
-- Anything added to NIGHT3_SPOTS above turns into a teleport button in the
-- Teleports box. To add your own to the Actions box:
--   Button(ActGroup, "Text", "tooltip", function() ... end)
--   ToggleButton(ActGroup, "Text", "tooltip", applyFn, revertFn)
--   Toggle(ActGroup, "UniqueId", { Text = "Text", Default = false, Callback = fn })
-- Wrapped in a do block so its locals do not count against the main chunk.
do
    local TPGroup  = Tabs.Night3:AddLeftGroupbox("Teleports")
    local ActGroup = Tabs.Night3:AddRightGroupbox("Actions")

    buildTeleports(TPGroup, NIGHT3_SPOTS)

    local AMMO_PILES     = { LeftAmmoPile = true, RightAmmoPile = true }
    local EXCLUDED_ROOTS = { Cabins = true }

    local function underExcludedRoot(inst)
        local parent = inst.Parent
        while parent and parent ~= Workspace do
            if EXCLUDED_ROOTS[parent.Name] then return true end
            parent = parent.Parent
        end
        return false
    end

    -- A spawn point that has nothing on it still holds an invisible placeholder,
    -- which is how the can teleport kept sending you to empty spots. Something
    -- actually spawned has at least one part you can see.
    local function isVisible(inst)
        if inst:IsA("BasePart") then return inst.Transparency < 1 end
        for _, part in ipairs(inst:GetDescendants()) do
            if part:IsA("BasePart") and part.Transparency < 1 then return true end
        end
        return false
    end

    -- Ammo only ever spawns inside the two piles, so the search starts from them
    -- rather than from every "Shells" in the map. The ones under Workspace.Cabins
    -- are scenery and are never reachable this way.
    local function ammoSpots()
        local piles, found = 0, {}
        for _, inst in ipairs(Workspace:GetDescendants()) do
            if AMMO_PILES[inst.Name] then
                piles += 1
                for _, child in ipairs(inst:GetDescendants()) do
                    if child.Name == "Shells" and not isCarried(child) then
                        local pos = worldPosition(child)
                        if pos then
                            table.insert(found, { pos = pos, path = child:GetFullName() })
                        end
                    end
                end
            end
        end
        return found, piles
    end

    local function canSpots()
        local found = {}
        for _, inst in ipairs(Workspace:GetDescendants()) do
            if inst.Name == "JerryCan" and not isCarried(inst) and not underExcludedRoot(inst) then
                local pos = worldPosition(inst)
                if pos and isVisible(inst) then
                    table.insert(found, { pos = pos, path = inst:GetFullName() })
                end
            end
        end
        return found
    end

    -- Lands you just above the target, keeping your facing, and pushes the old
    -- spot so "< Return" works. The path goes to the console so a wrong target
    -- can be identified by name.
    local function goTo(spot)
        local _, root = Char.require()
        warn("[Sulfoxium Hub] teleport target: " .. spot.path)
        pushPosition()
        pivotTo(CFrame.new(spot.pos + Vector3.new(0, 3, 0)) * root.CFrame.Rotation)
    end

    Button(ActGroup, "TP To Random Ammo", "Picks a random 'Shells' out of LeftAmmoPile / RightAmmoPile", function()
        local found, piles = ammoSpots()

        if piles == 0 then
            return notify("No LeftAmmoPile or RightAmmoPile in this map.", 6)
        end
        if #found == 0 then
            return notify(("Found %d ammo pile(s) but no Shells in them right now."):format(piles), 6)
        end

        goTo(found[math.random(1, #found)])
        notify(("Teleported to ammo — %d in the piles. '< Return' brings you back."):format(#found))
    end)

    Button(ActGroup, "TP To Nearest JerryCan", "Skips empty spawn points and anything under Cabins", function()
        local _, root = Char.require()
        local found = canSpots()
        if #found == 0 then
            return notify("No JerryCan has spawned right now.", 5)
        end

        local nearest, nearestDistance
        for _, spot in ipairs(found) do
            local distance = (spot.pos - root.Position).Magnitude
            if not nearestDistance or distance < nearestDistance then
                nearest, nearestDistance = spot, distance
            end
        end

        goTo(nearest)
        notify(("Teleported to a JerryCan %dm away — %d spawned. '< Return' brings you back.")
            :format(math.floor(nearestDistance), #found))
    end)

    local SAFE_SPOT = Vector3.new(194.70, 38.70, -215.17)

    Button(ActGroup, "Remove Mutant Worker", "Fires the KillPlayer remote", function()
        if fireRemote("KillPlayer") then notify("Mutant Worker removed.") end
    end)

    Button(ActGroup, "Make Sky Pure White", "Strips the sky and all shadows for maximum brightness", function()
        makeSkyPureWhite()
    end)

    Button(ActGroup, "Teleport To Safe Spot", "Teleports you to 194.70, 38.70, -215.17", function()
        local _, root = Char.require()

        pushPosition()
        -- Held longer than the default: this is the furthest jump in the script
        -- and the one the server pushed back on hardest.
        pivotTo(CFrame.new(SAFE_SPOT) * root.CFrame.Rotation, 0.75)

        notify("Teleported to the safe spot. '< Return' brings you back.")
    end)

    local function findDepthEffect()
        for _, inst in ipairs(Lighting:GetDescendants()) do
            if inst:IsA("DepthOfFieldEffect") or inst.Name:lower():find("depth", 1, true) then
                return inst
            end
        end
        return nil
    end

    local depthState

    -- Zeroing the far intensity kills the blur while leaving the effect in
    -- place, so nothing the cutscenes drive goes missing. The value is held
    -- because the game sets it as you play, and the original comes back on the
    -- second press.
    ToggleButton(ActGroup, "No Blur",
        "Sets the DepthOfField FarIntensity to 0 — press again to put it back",
        function()
            local effect = findDepthEffect()
            if not effect then
                notify("No DepthOfField effect found in Lighting.", 5)
                return false
            end

            depthState = { inst = effect, far = effect.FarIntensity }
            effect.FarIntensity = 0

            Master:Add(RunService.Heartbeat:Connect(function()
                if effect.Parent and effect.FarIntensity ~= 0 then
                    effect.FarIntensity = 0
                end
            end), "noBlur")

            warn(("[Sulfoxium Hub] holding %s FarIntensity at 0 (was %.3f)")
                :format(effect:GetFullName(), depthState.far))
            notify("Blur off — FarIntensity held at 0.")
        end,
        function()
            Master:Remove("noBlur")
            if depthState and depthState.inst.Parent then
                pcall(function() depthState.inst.FarIntensity = depthState.far end)
            end
            depthState = nil
            notify("FarIntensity restored.")
        end)

    -- Matched by class as well as name, so a renamed one is still found.
    local function isAtmosphere(inst)
        return inst:IsA("Atmosphere") or inst.Name == "Atmosphere"
    end

    Button(ActGroup, "Remove All Blurs", "Removes the Atmosphere from Lighting — nothing else is touched", function()
        local removed = 0

        for _, inst in ipairs(Lighting:GetDescendants()) do
            if isAtmosphere(inst) then
                warn(("[Sulfoxium Hub] removing %s (%s)"):format(inst:GetFullName(), inst.ClassName))
                if pcall(function() inst:Destroy() end) then removed += 1 end
            end
        end

        notify(removed > 0
            and ("Removed %d Atmosphere."):format(removed)
            or "No Atmosphere found in Lighting.", 5)
    end)

    -- Same machinery as the Visuals ESP toggles, just living in this tab.
    for _, cat in ipairs(ESP_CATEGORIES) do
        if cat.tab == "Night3" then
            buildEspToggle(ActGroup, cat)
        end
    end
end

-- Configs ---------------------------------------------------------------------
-- Every toggle and every slider, dropdown, input and colour is written to one
-- file per config. An index file lists them, so no executor-specific directory
-- listing is needed. Scoped so its locals are released.
do
    local ConfigGroup = Tabs.Configs:AddLeftGroupbox("Saved Configs")

    local FOLDER = CONFIG.SETTINGS_FOLDER .. "/configs"
    local INDEX  = FOLDER .. "/index.json"

    -- Dropdown selections that are rebuilt from the world each session, and the
    -- name box itself: restoring these would only put back stale entries.
    local SKIP = {
        WaypointName = true, WaypointList = true, PlayerList = true,
        N3SpotName = true, N3SpotList = true, ConfigName = true, ConfigList = true,
    }

    local names, listDropdown = {}, nil

    local function path(name)
        return ("%s/%s.json"):format(FOLDER, name)
    end

    local function encode(value)
        if typeof(value) == "Color3" then
            return { __color = {
                math.floor(value.R * 255 + 0.5),
                math.floor(value.G * 255 + 0.5),
                math.floor(value.B * 255 + 0.5),
            } }
        end
        return value
    end

    local function decode(value)
        if typeof(value) == "table" and value.__color then
            return Color3.fromRGB(value.__color[1], value.__color[2], value.__color[3])
        end
        return value
    end

    local function refresh()
        if not listDropdown then return end
        local shown = #names > 0 and names or { "(none)" }
        pcall(function() listDropdown:SetValues(shown) end)
    end

    local function saveIndex()
        table.sort(names)
        local ok, encoded = pcall(function() return HttpService:JSONEncode(names) end)
        if ok then Exec.write(INDEX, encoded) end
        refresh()
    end

    local function loadIndex()
        local contents = Exec.read(INDEX)
        if not contents then return end
        local ok, decoded = pcall(function() return HttpService:JSONDecode(contents) end)
        if ok and typeof(decoded) == "table" then
            for _, name in ipairs(decoded) do
                if Exec.read(path(name)) then table.insert(names, name) end
            end
        end
        refresh()
    end

    ConfigGroup:AddInput("ConfigName", {
        Text = "Config name",
        Default = "",
        Placeholder = "e.g. night 3 setup",
    })

    listDropdown = ConfigGroup:AddDropdown("ConfigList", {
        Values = { "(none)" },
        Default = 1,
        Multi = false,
        Text = "Saved configs",
    })

    Button(ConfigGroup, "Save Config", "Writes every toggle and value under the name above", function()
        if not Exec.hasFiles then
            return notify("This executor has no file access, so configs cannot be saved.", 6)
        end

        local name = opt("ConfigName", "")
        if name == nil or name == "" then
            return notify("Type a config name first.")
        end

        local data = { toggles = {}, options = {} }
        for id, entry in pairs(Toggles) do
            if not SKIP[id] then data.toggles[id] = entry.Value == true end
        end
        for id, entry in pairs(Options) do
            if not SKIP[id] and entry.Value ~= nil then
                data.options[id] = encode(entry.Value)
            end
        end

        local ok, encoded = pcall(function() return HttpService:JSONEncode(data) end)
        if not ok then return notify("Could not encode this config.", 5) end

        Exec.ensureFolder(CONFIG.SETTINGS_FOLDER)
        Exec.ensureFolder(FOLDER)
        if not Exec.write(path(name), encoded) then
            return notify("Could not write the config file.", 5)
        end

        local known = false
        for _, existing in ipairs(names) do
            if existing == name then known = true break end
        end
        if not known then table.insert(names, name) end
        saveIndex()

        notify(("Saved config '%s'."):format(name))
    end)

    Button(ConfigGroup, "Load Config", "Applies the selected config", function()
        local name = opt("ConfigList")
        if not name or name == "(none)" then return notify("No config selected.") end

        local contents = Exec.read(path(name))
        if not contents then return notify(("Config '%s' is missing."):format(name), 5) end

        local ok, data = pcall(function() return HttpService:JSONDecode(contents) end)
        if not ok or typeof(data) ~= "table" then
            return notify("That config file could not be read.", 5)
        end

        local applied = 0

        -- Values first, so a toggle that switches a feature on already sees the
        -- sliders and colours it depends on.
        for id, value in pairs(data.options or {}) do
            local entry = not SKIP[id] and Options[id]
            if entry and entry.SetValue then
                if pcall(function() entry:SetValue(decode(value)) end) then applied += 1 end
            end
        end

        for id, value in pairs(data.toggles or {}) do
            local entry = not SKIP[id] and Toggles[id]
            if entry and entry.SetValue then
                if pcall(function() entry:SetValue(value == true) end) then applied += 1 end
            end
        end

        notify(("Loaded '%s' — %d setting(s) applied."):format(name, applied), 5)
    end)

    Button(ConfigGroup, "Delete Config", "Removes the selected config", function()
        local name = opt("ConfigList")
        if not name or name == "(none)" then return notify("No config selected.") end

        Exec.delete(path(name))
        for index, existing in ipairs(names) do
            if existing == name then
                table.remove(names, index)
                break
            end
        end
        saveIndex()

        notify(("Deleted config '%s'."):format(name))
    end)

    Button(ConfigGroup, "Refresh List", "Re-reads the config folder", function()
        names = {}
        loadIndex()
        notify(("%d config(s) found."):format(#names))
    end)

    ConfigGroup:AddLabel("Configs are saved per executor, not per place, so one setup works across every night.")

    loadIndex()
end

local MenuGroup  = Tabs.Settings:AddLeftGroupbox("Menu")
local PanicGroup = Tabs.Settings:AddRightGroupbox("Panic")

MenuGroup:AddLabel("Use the Show Sulfoxium button at the top of the screen")

local panicked = false

local function panic(reason)
    if panicked then return end

    -- Nothing may unload the menu while it is still being built. A stray call
    -- during startup is what tore the UI down a moment after it appeared.
    if not uiReady then
        warn("[Sulfoxium Hub] ignored an unload during startup: " .. tostring(reason))
        return
    end

    panicked = true

    local keep = { AutoReapply = true, AntiAFK = true }
    eachToggle(function(name, toggle)
        if toggle.Value == true and not keep[name] then
            pcall(function() toggle:SetValue(false) end)
        end
    end)

    pcall(revertToggleButtons)

    Collision.releaseAll()

    local char = Char.get()
    if char then
        local hum = Char.humanoid()
        if hum then
            hum.WalkSpeed = baseWalkSpeed
            hum.JumpPower = baseJumpPower
            hum.PlatformStand = false
        end
        char:SetAttribute("SprintSpeed", CONFIG.DEFAULT_SPRINT_SPEED)
    end

    local camera = Workspace.CurrentCamera
    if camera then
        local hum = Char.humanoid()
        if hum then camera.CameraSubject = hum end
    end
    LocalPlayer.CameraMinZoomDistance = CameraState.defaultMin
    LocalPlayer.CameraMaxZoomDistance = CameraState.defaultMax

    ESP.running = false
    for inst in pairs(ESP.active) do
        removeEspEntry(inst)
    end

    Master:Clean()

    for _, container in ipairs({ hiddenUI, CoreGui }) do
        for _, obj in ipairs(container:GetChildren()) do
            if obj.Name == "RMx_ESP" or obj.Name == "RMx_ESPLabel"
                or obj.Name == "Sulfoxium Hub" or obj.Name == "TheBunkerHelper" then
                pcall(function() obj:Destroy() end)
            end
        end
    end

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Highlight") and (obj.Name == "RMx_ESP" or obj.Name == "ESPHighlight" or obj.Name == "AbomHighlight") then
            pcall(function() obj:Destroy() end)
        end
    end

    pcall(function() UI.destroy() end)
    warn("[Sulfoxium Hub] Unloaded (" .. tostring(reason) .. ")")
end

Button(MenuGroup, "Unload", "Reverts everything and closes the menu", function()
    panic("unload button")
end)

Button(PanicGroup, "PANIC — Unload Everything", "Reverts all changes and closes the menu", function()
    panic("panic button")
end)

Button(PanicGroup, "Soft Reset", "Turns every toggle and toggled button off but keeps the menu open", function()
    local keep = { AutoReapply = true, AntiAFK = true }
    eachToggle(function(name, toggle)
        if toggle.Value == true and not keep[name] then
            pcall(function() toggle:SetValue(false) end)
        end
    end)
    pcall(revertToggleButtons)
    Collision.releaseAll()
    notify("All features reset.")
end)

PanicGroup:AddLabel("Panic bind: End")

KEYBINDS.End = function() panic("panic keybind") end

Master:Add(UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

    local action = KEYBINDS[input.KeyCode.Name]
    if action then action() end
end))

refreshWaypointDropdown()
refreshPlayerDropdown()

-- Only now may anything unload the menu.
uiReady = true

notify(("Sulfoxium Hub loaded — %s"):format(SUPPORTED_PLACES[game.PlaceId]), 8)
