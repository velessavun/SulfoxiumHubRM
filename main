local CONFIG = {
    -- A full Workspace:GetDescendants() is what used to cause the ESP stutter,
    -- so it is now a rare resync (DescendantAdded catches everything between)
    -- and it is spread over several frames instead of blocking one.
    ESP_SWEEP_INTERVAL   = 15,
    ESP_SWEEP_BUDGET     = 1500,
    ESP_PLAYER_INTERVAL  = 1,
    ESP_LABEL_INTERVAL   = 0.08,
    ESP_MAX_DISTANCE     = 2000,
    ACTION_TIMEOUT       = 5,
    NOTIFY_TIME          = 4,
    DEFAULT_SPRINT_SPEED = 17,
    INF_VALUE            = 1e6,
    SURVIVAL_INTERVAL    = 1,
    -- Were sliders on the Bunker tab. Six attempts lets one run walk every can
    -- spot in the map before giving up.
    REFILL_TIMEOUT       = 3,
    REFILL_CAN_ATTEMPTS  = 6,
    PROMPT_INTERVAL      = 0.25,
    THREAT_INTERVAL      = 0.25,
    SETTINGS_FOLDER      = "SulfoxiumHubSettings",
}

local hiddenUI = (typeof(gethui) == "function" and gethui()) or CoreGui

local Exec = {}
do
    local _fireclick    = fireclickdetector
    local _fireprompt   = fireproximityprompt
    local _mousemoverel = mousemoverel
    local _setclipboard = setclipboard
    local _writefile    = writefile
    local _readfile     = readfile
    local _isfile       = isfile
    local _isfolder     = isfolder
    local _makefolder   = makefolder
    local _delfile      = delfile

    function Exec.clickDetector(detector)
        if typeof(_fireclick) ~= "function" or not detector then return false end
        return (pcall(_fireclick, detector))
    end

    function Exec.proximityPrompt(prompt)
        if typeof(_fireprompt) ~= "function" or not prompt then return false end
        return (pcall(_fireprompt, prompt))
    end

    function Exec.mouseMoveRel(dx, dy)
        if typeof(_mousemoverel) ~= "function" then return false end
        return (pcall(_mousemoverel, dx, dy))
    end

    function Exec.clipboard(text)
        if typeof(_setclipboard) ~= "function" then return false end
        return (pcall(_setclipboard, text))
    end

    function Exec.ensureFolder(name)
        if typeof(_isfolder) ~= "function" or typeof(_makefolder) ~= "function" then return false end
        local ok, exists = pcall(_isfolder, name)
        if ok and not exists then pcall(_makefolder, name) end
        return true
    end

    function Exec.write(path, contents)
        if typeof(_writefile) ~= "function" then return false end
        return (pcall(_writefile, path, contents))
    end

    function Exec.read(path)
        if typeof(_readfile) ~= "function" or typeof(_isfile) ~= "function" then return nil end
        local ok, exists = pcall(_isfile, path)
        if not ok or not exists then return nil end
        local read, contents = pcall(_readfile, path)
        return read and contents or nil
    end

    function Exec.delete(path)
        if typeof(_delfile) ~= "function" then return false end
        return (pcall(_delfile, path))
    end

    Exec.hasClick  = typeof(_fireclick) == "function"
    Exec.hasPrompt = typeof(_fireprompt) == "function"
    Exec.hasMouse  = typeof(_mousemoverel) == "function"
    Exec.hasFiles  = typeof(_writefile) == "function" and typeof(_readfile) == "function"
end

local DrawingLib = nil
do
    if typeof(Drawing) == "table" or typeof(Drawing) == "userdata" then
        local ok, obj = pcall(function() return Drawing.new("Line") end)
        if ok and obj then
            pcall(function() obj:Remove() end)
            DrawingLib = Drawing
        end
    end
end

local Janitor = {}
Janitor.__index = Janitor

function Janitor.new()
    return setmetatable({ _items = {}, _keyed = {} }, Janitor)
end

local function destroyItem(item)
    if item == nil then return end
    if typeof(item) == "RBXScriptConnection" then
        pcall(function() item:Disconnect() end)
    elseif typeof(item) == "Instance" then
        pcall(function() item:Destroy() end)
    elseif typeof(item) == "thread" then
        pcall(task.cancel, item)
    elseif typeof(item) == "function" then
        pcall(item)
    elseif typeof(item) == "table" then
        if item.Clean then
            pcall(function() item:Clean() end)
        elseif item.Remove then
            pcall(function() item:Remove() end)
        end
    end
end

function Janitor:Add(item, key)
    if item == nil then return item end
    if key then
        self:Remove(key)
        self._keyed[key] = item
    else
        table.insert(self._items, item)
    end
    return item
end

function Janitor:Has(key)
    return self._keyed[key] ~= nil
end

function Janitor:Remove(key)
    local item = self._keyed[key]
    if item then
        self._keyed[key] = nil
        destroyItem(item)
    end
end

function Janitor:Clean()
    for i = #self._items, 1, -1 do
        destroyItem(self._items[i])
        self._items[i] = nil
    end
    for k, v in pairs(self._keyed) do
        self._keyed[k] = nil
        destroyItem(v)
    end
end

local Master = Janitor.new()

local Rayfield

local function notify(text, duration)
    text = tostring(text)

    -- Falls back to the console rather than vanishing: before Rayfield has
    -- loaded there is nothing to draw on, and a notification that fails should
    -- still leave a trace.
    if not Rayfield or not Rayfield.Notify then
        warn("[Sulfoxium Hub] " .. text)
        return
    end

    local ok, err = pcall(function()
        Rayfield:Notify({
            Title = "Sulfoxium Hub",
            Content = text,
            Duration = duration or CONFIG.NOTIFY_TIME,
            Image = 4483362458,
        })
    end)

    if not ok then
        warn(("[Sulfoxium Hub] %s (notification failed: %s)"):format(text, tostring(err)))
    end
end

local function safe(fn, label)
    return function(...)
        local args = table.pack(...)
        local ok, err = pcall(function()
            return fn(table.unpack(args, 1, args.n))
        end)
        if not ok then
            warn(("[Sulfoxium Hub] %s failed: %s"):format(label or "action", tostring(err)))
            notify(("%s failed (see console)"):format(label or "Action"), 5)
        end
    end
end

local function spawnSafe(fn, label)
    task.spawn(safe(fn, label))
end

local function tog(name)
    local t = Toggles and Toggles[name]
    return t ~= nil and t.Value == true
end

local function opt(name, fallback)
    local o = Options and Options[name]
    if o ~= nil and o.Value ~= nil then return o.Value end
    return fallback
end

local function setToggle(name, value)
    local t = Toggles and Toggles[name]
    if t then pcall(function() t:SetValue(value) end) end
end

local function eachToggle(fn)
    if not Toggles then return end
    for name, toggle in pairs(Toggles) do
        if typeof(toggle) == "table" then fn(name, toggle) end
    end
end

local Char = {}

function Char.get()
    return LocalPlayer.Character
end

function Char.root()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

function Char.humanoid()
    local c = LocalPlayer.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

function Char.alive()
    local hum = Char.humanoid()
    return hum ~= nil and hum.Health > 0
end

function Char.require()
    local root = Char.root()
    if not root then
        error("character not ready", 0)
    end
    return LocalPlayer.Character, root
end

local Collision = {
    original = setmetatable({}, { __mode = "k" }),
    holders  = {},
    count    = 0,
}

function Collision.capture(part)
    if Collision.original[part] == nil then
        Collision.original[part] = part.CanCollide
    end
end

function Collision.apply()
    local char = Char.get()
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            Collision.capture(part)
            if part.CanCollide then
                part.CanCollide = false
            end
        end
    end
end

function Collision.restore()
    for part, was in pairs(Collision.original) do
        if typeof(part) == "Instance" and part.Parent then
            pcall(function() part.CanCollide = was end)
        end
    end
    Collision.original = setmetatable({}, { __mode = "k" })
end

function Collision.acquire(tag)
    if Collision.holders[tag] then return end
    Collision.holders[tag] = true
    Collision.count += 1
    if Collision.count == 1 then
        Collision.apply()
        Master:Add(RunService.Stepped:Connect(function()
            Collision.apply()
        end), "collisionLoop")
    end
end

function Collision.release(tag)
    if not Collision.holders[tag] then return end
    Collision.holders[tag] = nil
    Collision.count -= 1
    if Collision.count <= 0 then
        Collision.count = 0
        Master:Remove("collisionLoop")
        Collision.restore()
    end
end

function Collision.releaseAll()
    for tag in pairs(Collision.holders) do
        Collision.holders[tag] = nil
    end
    Collision.count = 0
    Master:Remove("collisionLoop")
    Collision.restore()
end

function Collision.onRespawn()
    Collision.original = setmetatable({}, { __mode = "k" })
    if Collision.count > 0 then
        Collision.apply()
    end
end

local function zeroVelocity(root)
    root.AssemblyLinearVelocity  = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
end

local function pivotTo(cframe)
    local char, root = Char.require()
    char:PivotTo(cframe)
    zeroVelocity(root)
end

local positionHistory = {}

local function pushPosition()
    local root = Char.root()
    if root then
        table.insert(positionHistory, root.CFrame)
        if #positionHistory > 30 then
            table.remove(positionHistory, 1)
        end
    end
end

local function popPosition()
    local cf = table.remove(positionHistory)
    if cf then
        pivotTo(cf)
        return true
    end
    return false
end

local function truthy(predicate)
    if not predicate then return true end
    local ok, value = pcall(predicate)
    return ok and value and true or false
end

local function actUntil(action, predicate, timeout)
    local deadline = os.clock() + (timeout or CONFIG.ACTION_TIMEOUT)
    local attempts = 0

    while true do
        if truthy(predicate) then
            return true, attempts
        end
        if os.clock() >= deadline then
            return false, attempts
        end
        if action then
            attempts += 1
            pcall(action)
        end
        RunService.Heartbeat:Wait()
    end
end

local function waitUntil(predicate, timeout)
    return (actUntil(nil, predicate, timeout))
end

local function runAt(destination, action, predicate, timeout)
    local char, root = Char.require()
    local origin = root.CFrame

    Collision.acquire("runAt")

    local ok, done, attempts = pcall(function()
        char:PivotTo(destination)
        zeroVelocity(root)
        return actUntil(action, predicate, timeout)
    end)

    if root.Parent then
        root.CFrame = origin
        zeroVelocity(root)
    end
    Collision.release("runAt")

    if not ok then error(done, 0) end
    return done, attempts
end

local function firePrompt(prompt)
    if not prompt or not prompt.Parent or not prompt.Enabled then return false end

    local hold, distance = prompt.HoldDuration, prompt.MaxActivationDistance
    pcall(function()
        prompt.HoldDuration = 0
        prompt.MaxActivationDistance = math.huge
    end)

    local fired = Exec.proximityPrompt(prompt)

    pcall(function()
        prompt.HoldDuration = hold
        prompt.MaxActivationDistance = distance
    end)
    return fired
end

local function interact(target)
    if typeof(target) ~= "Instance" or not target.Parent then return false end

    if target:IsA("ClickDetector") then return Exec.clickDetector(target) end
    if target:IsA("ProximityPrompt") then return firePrompt(target) end

    local click = target:FindFirstChildWhichIsA("ClickDetector", true)
    if click and Exec.clickDetector(click) then return true end

    local prompt = target:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt and firePrompt(prompt) then return true end

    return false
end

local function collectTriggers(root)
    local triggers = {}
    if not root then return triggers end
    if root:IsA("ClickDetector") or root:IsA("ProximityPrompt") then
        table.insert(triggers, root)
    end
    for _, child in ipairs(root:GetDescendants()) do
        if child:IsA("ClickDetector") or child:IsA("ProximityPrompt") then
            table.insert(triggers, child)
        end
    end
    return triggers
end

local function triggersLive(triggers)
    local live = 0
    for _, trigger in ipairs(triggers) do
        if trigger.Parent and not (trigger:IsA("ProximityPrompt") and not trigger.Enabled) then
            live += 1
        end
    end
    return live
end

local function toolSnapshot()
    local snapshot = {}
    local containers = { Char.get(), LocalPlayer:FindFirstChildOfClass("Backpack") }
    for _, container in ipairs(containers) do
        if container then
            for _, item in ipairs(container:GetChildren()) do
                if item:IsA("Tool") then snapshot[item] = true end
            end
        end
    end
    return snapshot
end

local function newToolSince(snapshot)
    local containers = { Char.get(), LocalPlayer:FindFirstChildOfClass("Backpack") }
    for _, container in ipairs(containers) do
        if container then
            for _, item in ipairs(container:GetChildren()) do
                if item:IsA("Tool") and not snapshot[item] then return item end
            end
        end
    end
    return nil
end

local function toolGone(tool)
    return not tool or not tool.Parent
end

local function mainPartOf(inst)
    if inst:IsA("BasePart") then return inst end
    if inst:IsA("Model") and inst.PrimaryPart then return inst.PrimaryPart end
    if inst:IsA("Tool") then
        local handle = inst:FindFirstChild("Handle")
        if handle and handle:IsA("BasePart") then return handle end
    end

    local best, bestVolume
    for _, child in ipairs(inst:GetDescendants()) do
        if child:IsA("BasePart") then
            local volume = child.Size.X * child.Size.Y * child.Size.Z
            if not bestVolume or volume > bestVolume then
                best, bestVolume = child, volume
            end
        end
    end
    return best
end

local function worldPosition(inst)
    local part = mainPartOf(inst)
    return part and part.Position
end

local function remotes()
    return ReplicatedStorage:FindFirstChild("Remotes")
end

local function fireRemote(name, ...)
    local folder = remotes()
    local remote = folder and folder:FindFirstChild(name)
    if not remote then
        notify(("Remote '%s' not found in this place."):format(name), 5)
        return false
    end
    remote:FireServer(...)
    return true
end

local ACSuppressor = {
    disabledScripts = {},
    kickSwapped     = false,
}

local AC_SCRIPT_PATTERNS = { "anticheat", "anti_cheat", "security", "detect" }

local function looksLikeACScript(name)
    local lower = name:lower()
    for _, pattern in ipairs(AC_SCRIPT_PATTERNS) do
        if lower:find(pattern, 1, true) then return true end
    end
    return false
end

function ACSuppressor.swapKickRemote()
    local folder = remotes()
    if not folder then return false end
    if folder:FindFirstChild("DisabledKick") then
        ACSuppressor.kickSwapped = true
        return true
    end

    local kick = folder:FindFirstChild("Kick")
    if not kick then return false end

    kick.Name = "DisabledKick"
    local decoy = Instance.new("RemoteEvent")
    decoy.Name = "Kick"
    decoy.Parent = folder
    Master:Add(decoy, "kickDecoy")
    ACSuppressor.kickSwapped = true
    return true
end

function ACSuppressor.disableLocalScripts()
    local disabled = 0
    local roots = { LocalPlayer:FindFirstChild("PlayerScripts"), LocalPlayer:FindFirstChild("PlayerGui") }
    for _, root in ipairs(roots) do
        if root then
            for _, obj in ipairs(root:GetDescendants()) do
                if obj:IsA("LocalScript") and not obj.Disabled and looksLikeACScript(obj.Name) then
                    obj.Disabled = true
                    table.insert(ACSuppressor.disabledScripts, obj)
                    disabled += 1
                end
            end
        end
    end
    return disabled
end

function ACSuppressor.run()
    local swapped, count = false, 0
    pcall(function() swapped = ACSuppressor.swapKickRemote() end)
    pcall(function() count = ACSuppressor.disableLocalScripts() end)
    return swapped, count
end

function ACSuppressor.restore()
    if ACSuppressor.kickSwapped then
        Master:Remove("kickDecoy")
        local folder = remotes()
        local real = folder and folder:FindFirstChild("DisabledKick")
        if real then
            local leftover = folder:FindFirstChild("Kick")
            if leftover and leftover ~= real then
                pcall(function() leftover:Destroy() end)
            end
            pcall(function() real.Name = "Kick" end)
        end
        ACSuppressor.kickSwapped = false
    end

    local restored = 0
    for _, obj in ipairs(ACSuppressor.disabledScripts) do
        if typeof(obj) == "Instance" and obj.Parent then
            pcall(function() obj.Disabled = false end)
            restored += 1
        end
    end
    ACSuppressor.disabledScripts = {}
    return restored
end

spawnSafe(function() ACSuppressor.run() end, "AC suppressor")

