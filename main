local ESP = {
    active  = {},
    enabled = {},
    running = false,
}

local ESP_NAME_CATEGORIES = {}
local ESP_PATTERN_CATEGORIES = {}

-- Anything sitting inside an object that is already highlighted is a duplicate
-- of it: a handle inside its own model, a frame part inside the bed it belongs
-- to, a gauge part inside the generator. Word matches count as well, otherwise
-- every plank of a bed frame would get its own outline.
local function notNestedInMatch(inst)
    local parent = inst.Parent
    while parent and parent ~= Workspace do
        if ESP_NAME_CATEGORIES[parent.Name] then return false end

        local lowerName
        for _, cat in ipairs(ESP_PATTERN_CATEGORIES) do
            lowerName = lowerName or parent.Name:lower()
            for _, word in ipairs(cat.patterns) do
                if lowerName:find(word, 1, true) then return false end
            end
        end

        parent = parent.Parent
    end
    return true
end

local ESP_CATEGORIES = {
    { key = "Players", text = "Players", default = Color3.fromRGB(80, 140, 255) },
    { key = "Larry", text = "Larry (Mutant)", default = Color3.fromRGB(255, 60, 60), names = { Mutant = true } },
    { key = "Stalker", text = "Stalker", default = Color3.fromRGB(255, 0, 200), names = { Stalker = true } },
    { key = "Zombies", text = "Zombies", default = Color3.fromRGB(120, 255, 120), names = { Zombie = true, BloodZombie = true, FrozenZombie = true, FrozenBloodZombie = true } },
    { key = "Abomination", text = "Abomination / Rat", default = Color3.fromRGB(255, 0, 255), names = { BunkerRat = true, Abomination = true, Monster = true } },
    { key = "Generators", text = "Generators", default = Color3.fromRGB(255, 170, 0), names = { Generator = true, Gen = true } },
    -- Night 3 scatters far more cans than the three that matter, so the toggle
    -- is not offered there. Every other place keeps it.
    { key = "Fuel", text = "Fuel / JerryCan", default = Color3.fromRGB(0, 255, 120), names = { JerryCan = true, Gasoline = true, Fuel = true }, hideIn = { [NIGHT3_PLACE_ID] = true } },
    { key = "Monster", text = "Mutant Worker", default = Color3.fromRGB(255, 80, 0), names = { Mutant = true, Worker = true }, tab = "Night3" },
    { key = "WorkerHead", text = "WorkerHead", default = Color3.fromRGB(255, 230, 0), names = { WorkerHead = true }, tab = "Night3" },
    -- Wood and Log used to live here: they are not pickups, and bed frames are
    -- built out of parts using those names, which is why beds lit up too.
    { key = "Items", text = "Items / Pickups", default = Color3.fromRGB(255, 255, 120), names = { Battery = true, Flashlight = true, Medkit = true, Bandage = true, Key = true, Keycard = true, Marshmallow = true }, filter = notNestedInMatch },
    -- Beds are named inconsistently from map to map — the Bunker's did not match
    -- any exact spelling — so this one matches on the word instead. "bedroom" is
    -- excluded so a whole room does not light up.
    { key = "Beds", text = "Beds", default = Color3.fromRGB(120, 200, 255), names = { Bed = true, Beds = true, BunkBed = true, Bunk = true },
      patterns = { "bed", "bunk" }, excludes = { "bedroom" }, filter = notNestedInMatch },
}

local THREAT_KEYS = { Larry = true, Stalker = true, Zombies = true, Abomination = true, Monster = true }

-- name -> the categories claiming it. A sweep tests thousands of instances, so
-- matching has to be one hash lookup rather than a walk over every category's
-- name table. A name can belong to more than one category — "Mutant" is both
-- Larry and Monster — so this holds a list and the enabled one wins.
for _, cat in ipairs(ESP_CATEGORIES) do
    if cat.names then
        for name in pairs(cat.names) do
            local claimed = ESP_NAME_CATEGORIES[name]
            if claimed then
                table.insert(claimed, cat)
            else
                ESP_NAME_CATEGORIES[name] = { cat }
            end
        end
    end
end

-- Categories that also match on a word inside the name. Kept as its own short
-- list so the sweep only pays for the lowercase conversion when one of them is
-- actually switched on.
for _, cat in ipairs(ESP_CATEGORIES) do
    if cat.patterns then
        table.insert(ESP_PATTERN_CATEGORIES, cat)
    end
end

local function espColor(key)
    local value = opt("ESP_" .. key .. "Color")
    if value then return value end
    for _, cat in ipairs(ESP_CATEGORIES) do
        if cat.key == key then return cat.default end
    end
    return Color3.new(1, 1, 1)
end

-- Your own character is drawn in dark green so it never reads as another player.
local SELF_ESP_COLOR = Color3.fromRGB(0, 80, 20)

local function makeEspEntry(inst, key, label, colorOverride)
    local color = colorOverride or espColor(key)

    local highlight = Instance.new("Highlight")
    highlight.Name = "RMx_ESP"
    highlight.Adornee = inst
    highlight.FillColor = color
    highlight.OutlineColor = Color3.new(1, 1, 1)
    highlight.FillTransparency = 0.6
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = hiddenUI

    local adornPart = inst:IsA("Model")
        and (inst:FindFirstChild("Head") or inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart"))
        or inst

    local billboard, textLabel
    if adornPart and adornPart:IsA("BasePart") then
        billboard = Instance.new("BillboardGui")
        billboard.Name = "RMx_ESPLabel"
        billboard.Adornee = adornPart
        billboard.Size = UDim2.new(0, 220, 0, 34)
        billboard.StudsOffset = Vector3.new(0, 2.5, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = hiddenUI

        textLabel = Instance.new("TextLabel")
        textLabel.BackgroundTransparency = 1
        textLabel.Size = UDim2.fromScale(1, 1)
        textLabel.Font = Enum.Font.GothamMedium
        textLabel.TextSize = 13
        textLabel.TextColor3 = color
        textLabel.TextStrokeTransparency = 0.4
        textLabel.Text = label or inst.Name
        textLabel.Parent = billboard
    end

    return {
        key           = key,
        label         = label or inst.Name,
        color         = color,
        colorOverride = colorOverride,
        highlight     = highlight,
        billboard     = billboard,
        text          = textLabel,
        adornPart     = adornPart,
        humanoid      = inst:IsA("Model") and inst:FindFirstChildOfClass("Humanoid") or nil,
        tracer        = nil,
    }
end

local function destroyTracer(entry)
    if entry.tracer then
        pcall(function() entry.tracer:Remove() end)
        entry.tracer = nil
    end
end

local function removeEspEntry(inst)
    local entry = ESP.active[inst]
    if not entry then return end
    ESP.active[inst] = nil
    destroyItem(entry.highlight)
    destroyItem(entry.billboard)
    destroyTracer(entry)
end

local function addEspEntry(inst, key, label, colorOverride)
    ESP.active[inst] = makeEspEntry(inst, key, label, colorOverride)
end

local function matchesPattern(cat, lowerName)
    for _, word in ipairs(cat.excludes or {}) do
        if lowerName:find(word, 1, true) then return false end
    end
    for _, word in ipairs(cat.patterns) do
        if lowerName:find(word, 1, true) then return true end
    end
    return false
end

local function categoryFor(inst)
    -- Name first: it rejects almost every instance for the price of one lookup,
    -- where IsA is a call into the engine for each of the two class tests.
    local claimed = ESP_NAME_CATEGORIES[inst.Name]

    if claimed then
        if not inst:IsA("Model") and not inst:IsA("BasePart") then return nil end

        for _, cat in ipairs(claimed) do
            if ESP.enabled[cat.key] and (not cat.filter or cat.filter(inst)) then
                return cat.key
            end
        end
        return nil
    end

    -- Word matching, only for the categories that asked for it and only while
    -- one of them is switched on, so the usual sweep pays nothing for this.
    local lowerName
    for _, cat in ipairs(ESP_PATTERN_CATEGORIES) do
        if ESP.enabled[cat.key] then
            lowerName = lowerName or inst.Name:lower()
            if matchesPattern(cat, lowerName)
                and (inst:IsA("Model") or inst:IsA("BasePart"))
                and (not cat.filter or cat.filter(inst)) then
                return cat.key
            end
        end
    end
    return nil
end

local function considerInstance(inst)
    if ESP.active[inst] then return end
    local key = categoryFor(inst)
    if key then
        addEspEntry(inst, key)
    end
end

-- Cheap: at most a handful of players, safe to run every second. Your own
-- character is included so you get the same box, outline and name tag.
local function sweepPlayers()
    if not ESP.enabled.Players then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        local char = plr.Character
        if char and not ESP.active[char] then
            addEspEntry(char, "Players", plr.Name, plr == LocalPlayer and SELF_ESP_COLOR or nil)
        end
    end
end

-- Expensive: builds an array of every instance in the map. Yields every
-- ESP_SWEEP_BUDGET instances so the cost lands across frames rather than as
-- one visible hitch, and only runs as an occasional resync.
local function sweepWorkspace()
    local processed = 0
    for _, inst in ipairs(Workspace:GetDescendants()) do
        if not ESP.running then return end
        considerInstance(inst)
        processed += 1
        if processed >= CONFIG.ESP_SWEEP_BUDGET then
            processed = 0
            RunService.Heartbeat:Wait()
        end
    end
    sweepPlayers()
end

local function pruneEsp()
    for inst, entry in pairs(ESP.active) do
        if not inst.Parent or not ESP.enabled[entry.key] then
            removeEspEntry(inst)
        end
    end
end

local nearestThreat = { name = nil, distance = math.huge }

local function startEsp()
    if ESP.running then return end
    ESP.running = true

    Master:Add(Workspace.DescendantAdded:Connect(function(inst)
        if not ESP.running then return end
        -- This fires for every part the game streams in, so reject non-matches
        -- here instead of paying for a deferred closure on each one.
        if not ESP_NAME_CATEGORIES[inst.Name] then return end
        task.defer(function()
            if inst.Parent then considerInstance(inst) end
        end)
    end), "espAdded")

    task.spawn(function()
        while ESP.running do
            pcall(sweepPlayers)
            pcall(pruneEsp)
            task.wait(CONFIG.ESP_PLAYER_INTERVAL)
        end
    end)

    task.spawn(function()
        while ESP.running do
            task.wait(CONFIG.ESP_SWEEP_INTERVAL)
            if ESP.running then pcall(sweepWorkspace) end
        end
    end)

    local accumulator = CONFIG.ESP_LABEL_INTERVAL
    Master:Add(RunService.RenderStepped:Connect(function(dt)
        local camera = Workspace.CurrentCamera
        local tracersOn = DrawingLib ~= nil and camera ~= nil and tog("ESPTracers")

        accumulator += dt
        local doLabels = accumulator >= CONFIG.ESP_LABEL_INTERVAL
        if doLabels then accumulator = 0 end

        -- With tracers off there is nothing to do on the frames between label
        -- updates, so do not walk the entry list on them at all.
        if not doLabels and not tracersOn then return end

        local root = Char.root()
        if not root then return end
        local origin = root.Position
        local maxDistance = opt("ESPDistance", CONFIG.ESP_MAX_DISTANCE)

        -- Tracers start from the middle of the screen, where the crosshair sits
        -- in first person, rather than from the bottom edge.
        local viewport = camera and camera.ViewportSize
        local tracerOrigin = viewport and Vector2.new(viewport.X / 2, viewport.Y / 2)
        local closestName, closestDistance = nil, math.huge

        for inst, entry in pairs(ESP.active) do
            local part = entry.adornPart
            if part and part.Parent then
                local distance = (part.Position - origin).Magnitude
                local visible = distance <= maxDistance

                if doLabels then
                    if THREAT_KEYS[entry.key] and distance < closestDistance then
                        closestName, closestDistance = entry.label, distance
                    end

                    if entry.billboard then
                        entry.billboard.Enabled = visible
                        if visible and entry.text then
                            local suffix = ""
                            if entry.humanoid and entry.humanoid.Parent then
                                suffix = (" | %d HP"):format(math.floor(entry.humanoid.Health))
                            end
                            entry.text.Text = ("%s  [%dm]%s"):format(entry.label, math.floor(distance), suffix)
                        end
                    end
                end

                if tracersOn and visible then
                    if not entry.tracer then
                        local ok, line = pcall(function() return DrawingLib.new("Line") end)
                        if ok and line then
                            line.Thickness = opt("TracerThickness", 1)
                            line.Transparency = 1
                            line.Color = entry.color
                            entry.tracer = line
                        end
                    end
                    local tracer = entry.tracer
                    if tracer then
                        local screenPos, onScreen = camera:WorldToViewportPoint(part.Position)
                        if onScreen then
                            tracer.From = tracerOrigin
                            tracer.To = Vector2.new(screenPos.X, screenPos.Y)
                            tracer.Visible = true
                        else
                            tracer.Visible = false
                        end
                    end
                elseif entry.tracer then
                    entry.tracer.Visible = false
                end
            end
        end

        if doLabels then
            nearestThreat.name = closestName
            nearestThreat.distance = closestDistance
        end
    end), "espLabels")
end

local function stopEspIfIdle()
    for _, enabled in pairs(ESP.enabled) do
        if enabled then return end
    end
    ESP.running = false
    Master:Remove("espAdded")
    Master:Remove("espLabels")
    for inst in pairs(ESP.active) do
        removeEspEntry(inst)
    end
    nearestThreat.name = nil
    nearestThreat.distance = math.huge
end

-- Shared so a category can be placed in another tab's groupbox and still be a
-- normal ESP toggle. Categories tagged with a tab are built by that tab.
local function buildEspToggle(group, cat)
    local toggle = Toggle(group, "ESP_" .. cat.key, {
        Text = cat.text,
        Default = false,
        Callback = function(state)
            ESP.enabled[cat.key] = state
            if state then
                startEsp()
                spawnSafe(sweepWorkspace, "ESP sweep")
            else
                pruneEsp()
                stopEspIfIdle()
            end
        end,
    })

    pcall(function()
        toggle:AddColorPicker("ESP_" .. cat.key .. "Color", {
            Default = cat.default,
            Title = cat.text .. " colour",
            Callback = function(color)
                for _, entry in pairs(ESP.active) do
                    -- Your own character keeps its dark green whatever the
                    -- Players colour is set to.
                    if entry.key == cat.key and not entry.colorOverride then
                        entry.color = color
                        entry.highlight.FillColor = color
                        if entry.text then entry.text.TextColor3 = color end
                        if entry.tracer then entry.tracer.Color = color end
                    end
                end
            end,
        })
    end)

    return toggle
end

for _, cat in ipairs(ESP_CATEGORIES) do
    local hidden = cat.hideIn and cat.hideIn[game.PlaceId]
    if not cat.tab and not hidden then
        buildEspToggle(ESPGroup, cat)
    end
end

Toggle(ESPGroup, "ESPTracers", {
    Text = "Tracers",
    Default = false,
    Tooltip = DrawingLib and "Redraws every frame so lines stay glued to the target" or "Unsupported: no Drawing API",
    Callback = function(state)
        if state and not DrawingLib then
            notify("Executor has no Drawing API — tracers unavailable.", 5)
            setToggle("ESPTracers", false)
            return
        end
        if not state then
            for _, entry in pairs(ESP.active) do
                destroyTracer(entry)
            end
        end
    end,
})

ESPGroup:AddSlider("TracerThickness", {
    Text = "Tracer thickness",
    Default = 1,
    Min = 1,
    Max = 5,
    Rounding = 0,
    Callback = function(value)
        for _, entry in pairs(ESP.active) do
            if entry.tracer then entry.tracer.Thickness = value end
        end
    end,
})

ESPGroup:AddSlider("ESPDistance", {
    Text = "Label distance",
    Default = CONFIG.ESP_MAX_DISTANCE,
    Min = 100,
    Max = 5000,
    Rounding = 0,
    Suffix = "m",
})

-- Categories tagged with a tab live in that tab, so this only covers the ones
-- shown here plus tracers. Anything already on means the press turns all off.
Button(ESPGroup, "Toggle All ESP", "Turns every ESP in this tab and tracers on, or all off", function()
    local anyOn = tog("ESPTracers")

    if not anyOn then
        for _, cat in ipairs(ESP_CATEGORIES) do
            if not cat.tab and tog("ESP_" .. cat.key) then
                anyOn = true
                break
            end
        end
    end

    local target = not anyOn
    for _, cat in ipairs(ESP_CATEGORIES) do
        if not cat.tab then
            setToggle("ESP_" .. cat.key, target)
        end
    end
    setToggle("ESPTracers", target)

    notify(target and "All ESP enabled." or "All ESP disabled.")
end)

Button(ESPGroup, "Clear All ESP", "Disables every ESP category", function()
    for _, cat in ipairs(ESP_CATEGORIES) do
        setToggle("ESP_" .. cat.key, false)
    end
    setToggle("ESPTracers", false)
    notify("ESP cleared.")
end)

-- Scoped so its locals are released at the end of the block: the main chunk
-- is close to Luau's 200 simultaneous locals and this section holds fifteen.
local restoreLighting

do
    -- Atmosphere and Sky have no Enabled property, so reading or writing it throws.
    -- Only PostEffect subclasses (blur, colour correction, bloom, sun rays, depth of
    -- field) can be switched off in place; those two get detached and put back.
    local Effects = { detached = {} }

    function Effects.detach(inst)
        if not inst.Parent then return end
        table.insert(Effects.detached, { inst = inst, parent = inst.Parent })
        inst.Parent = nil
    end

    function Effects.restore()
        for _, entry in ipairs(Effects.detached) do
            pcall(function() entry.inst.Parent = entry.parent end)
        end
        Effects.detached = {}
    end

    function Effects.kill(inst, enabledStore)
        if inst:IsA("PostEffect") then
            if enabledStore and enabledStore[inst] == nil then
                enabledStore[inst] = inst.Enabled
            end
            if inst.Enabled then inst.Enabled = false end
        elseif inst:IsA("Atmosphere") or inst:IsA("Sky") then
            Effects.detach(inst)
        end
    end

    local LightingState = { snapshot = nil, effectStates = nil }

    local LIGHTING_PROPS = {
        "Brightness", "FogEnd", "FogStart", "GlobalShadows",
        "Ambient", "OutdoorAmbient", "ShadowSoftness", "ExposureCompensation",
    }

    local function snapshotLighting()
        if LightingState.snapshot then return end

        local snap = {}
        for _, prop in ipairs(LIGHTING_PROPS) do
            local ok, value = pcall(function() return Lighting[prop] end)
            if ok then snap[prop] = value end
        end
        LightingState.snapshot = snap

        local states = {}
        for _, child in ipairs(Lighting:GetChildren()) do
            if child:IsA("PostEffect") then
                states[child] = child.Enabled
            end
        end
        LightingState.effectStates = states
    end

    local function suppressEffects()
        for _, child in ipairs(Lighting:GetChildren()) do
            Effects.kill(child, LightingState.effectStates)
        end
        local gui = LocalPlayer:FindFirstChild("PlayerGui")
        if gui then
            for _, obj in ipairs(gui:GetDescendants()) do
                if obj:IsA("BlurEffect") then obj.Enabled = false end
            end
        end
    end

    local FULLBRIGHT_MAX = 6

    local PURE_EFFECT_CLASSES = {
        "BlurEffect", "ColorCorrectionEffect", "SunRaysEffect", "BloomEffect",
        "DepthOfFieldEffect", "Atmosphere", "Sky",
    }

    local Pure = {
        active  = false,
        effects = setmetatable({}, { __mode = "k" }),
        parts   = setmetatable({}, { __mode = "k" }),
        lights  = setmetatable({}, { __mode = "k" }),
        props   = nil,
    }

    local function isPureEffect(inst)
        for _, className in ipairs(PURE_EFFECT_CLASSES) do
            if inst:IsA(className) then return true end
        end
        return false
    end

    local function pureKillEffect(inst)
        if not isPureEffect(inst) then return end
        Effects.kill(inst, Pure.effects)
    end

    local function pureStripShadows(inst)
        if inst:IsA("BasePart") then
            if Pure.parts[inst] == nil then
                Pure.parts[inst] = inst.CastShadow
            end
            if inst.CastShadow then inst.CastShadow = false end
        elseif inst:IsA("Light") then
            if Pure.lights[inst] == nil then
                Pure.lights[inst] = inst.Shadows
            end
            if inst.Shadows then inst.Shadows = false end
        end
    end

    local function pureSweep()
        for _, container in ipairs({ Lighting, Workspace.CurrentCamera, LocalPlayer:FindFirstChild("PlayerGui") }) do
            if container then
                for _, inst in ipairs(container:GetDescendants()) do
                    pureKillEffect(inst)
                end
            end
        end
        for _, inst in ipairs(Workspace:GetDescendants()) do
            pureKillEffect(inst)
            pureStripShadows(inst)
        end
    end

    local function pureApplyProps()
        Lighting.GlobalShadows = false
        Lighting.ShadowSoftness = 0
        Lighting.FogStart = 1e6
        Lighting.FogEnd = 1e6
        Lighting.Ambient = Color3.new(1, 1, 1)
        Lighting.OutdoorAmbient = Color3.new(1, 1, 1)
        Lighting.ColorShift_Top = Color3.new(1, 1, 1)
        Lighting.ColorShift_Bottom = Color3.new(1, 1, 1)
        pcall(function() Lighting.EnvironmentDiffuseScale = 1 end)
        pcall(function() Lighting.EnvironmentSpecularScale = 0 end)
        pcall(function() Lighting.ExposureCompensation = 0 end)
    end

    function Pure.enable()
        if Pure.active then return end
        Pure.active = true

        Pure.props = {}
        for _, prop in ipairs({ "ColorShift_Top", "ColorShift_Bottom", "EnvironmentDiffuseScale", "EnvironmentSpecularScale" }) do
            local ok, value = pcall(function() return Lighting[prop] end)
            if ok then Pure.props[prop] = value end
        end

        pureApplyProps()
        pureSweep()

        Master:Add(Workspace.DescendantAdded:Connect(function(inst)
            if not Pure.active then return end
            task.defer(function()
                if not inst.Parent then return end
                pureKillEffect(inst)
                pureStripShadows(inst)
            end)
        end), "pureAdded")

        Master:Add(Lighting.DescendantAdded:Connect(function(inst)
            if not Pure.active then return end
            task.defer(function()
                if inst.Parent then pureKillEffect(inst) end
            end)
        end), "pureLighting")

        local accumulator = 0
        Master:Add(RunService.Heartbeat:Connect(function(dt)
            if not Pure.active then return end
            accumulator += dt
            if accumulator < 2 then return end
            accumulator = 0
            pureApplyProps()
            pureSweep()
        end), "pureHold")
    end

    function Pure.disable()
        if not Pure.active then return end
        Pure.active = false

        Master:Remove("pureAdded")
        Master:Remove("pureLighting")
        Master:Remove("pureHold")

        Effects.restore()

        for inst, wasEnabled in pairs(Pure.effects) do
            if typeof(inst) == "Instance" and inst.Parent then
                pcall(function() inst.Enabled = wasEnabled end)
            end
        end
        for part, castShadow in pairs(Pure.parts) do
            if typeof(part) == "Instance" and part.Parent then
                pcall(function() part.CastShadow = castShadow end)
            end
        end
        for light, shadows in pairs(Pure.lights) do
            if typeof(light) == "Instance" and light.Parent then
                pcall(function() light.Shadows = shadows end)
            end
        end
        if Pure.props then
            for prop, value in pairs(Pure.props) do
                pcall(function() Lighting[prop] = value end)
            end
        end

        Pure.effects = setmetatable({}, { __mode = "k" })
        Pure.parts = setmetatable({}, { __mode = "k" })
        Pure.lights = setmetatable({}, { __mode = "k" })
        Pure.props = nil
    end

    local FULLBRIGHT_PROPS = {
        Brightness = true, FogEnd = true, GlobalShadows = true,
        Ambient = true, OutdoorAmbient = true, ShadowSoftness = true,
    }

    -- One setting, fully on: brightness at the top of the range and pure mode with
    -- it, so every shadow, blur and post effect is stripped rather than dimmed.
    local function applyFullbright()
        Lighting.Brightness = FULLBRIGHT_MAX
        Lighting.FogEnd = 1e6
        Lighting.GlobalShadows = false
        Lighting.Ambient = Color3.fromRGB(255, 255, 255)
        Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
        Lighting.ShadowSoftness = 0

        Pure.enable()
    end

    function restoreLighting()
        Pure.disable()
        Effects.restore()
        if not LightingState.snapshot then return end
        for prop, value in pairs(LightingState.snapshot) do
            pcall(function() Lighting[prop] = value end)
        end
        if LightingState.effectStates then
            for effect, wasEnabled in pairs(LightingState.effectStates) do
                if effect.Parent then
                    pcall(function() effect.Enabled = wasEnabled end)
                end
            end
        end
        LightingState.snapshot = nil
        LightingState.effectStates = nil
    end

    Toggle(LightingGroup, "Fullbright", {
        Text = "Fullbright",
        Default = false,
        Tooltip = "Full brightness with every shadow, blur and post-effect stripped",
        Callback = function(state)
            if state then
                snapshotLighting()
                applyFullbright()
                suppressEffects()

                Master:Add(Lighting.Changed:Connect(function(property)
                    if FULLBRIGHT_PROPS[property] and tog("Fullbright") then
                        applyFullbright()
                    end
                end), "fbChanged")

                Master:Add(Lighting.ChildAdded:Connect(function(child)
                    if not tog("Fullbright") then return end
                    task.defer(function()
                        if child.Parent then
                            Effects.kill(child, LightingState.effectStates)
                        end
                    end)
                end), "fbChildAdded")

                notify("Fullbright enabled.")
            else
                Master:Remove("fbChanged")
                Master:Remove("fbChildAdded")
                restoreLighting()
                notify("Fullbright disabled.")
            end
        end,
    })
end

local CameraState = { defaultMin = 0.5, defaultMax = 128 }

do
    CameraState.defaultMin = LocalPlayer.CameraMinZoomDistance
    CameraState.defaultMax = LocalPlayer.CameraMaxZoomDistance
end

Toggle(CameraGroup, "UnlockZoom", {
    Text = "Unlock Camera Zoom",
    Default = false,
    Callback = function(state)
        if state then
            LocalPlayer.CameraMinZoomDistance = 0.5
            LocalPlayer.CameraMaxZoomDistance = 1000
        else
            LocalPlayer.CameraMinZoomDistance = CameraState.defaultMin
            LocalPlayer.CameraMaxZoomDistance = CameraState.defaultMax
        end
    end,
})

Toggle(CameraGroup, "ThirdPerson", {
    Text = "Force Third Person",
    Default = false,
    Tooltip = "Puts your camera mode and zoom back exactly as they were when you switched it on",
    Callback = function(state)
        if state then
            -- Snapshot live values, not the ones captured at script load: the
            -- game locks you into first person during Night 1/2, so those are
            -- what has to come back when this is switched off.
            CameraState.savedMode = LocalPlayer.CameraMode
            CameraState.savedMin  = LocalPlayer.CameraMinZoomDistance

            LocalPlayer.CameraMode = Enum.CameraMode.Classic
            LocalPlayer.CameraMinZoomDistance = 8

            Master:Add(RunService.Heartbeat:Connect(function()
                if not tog("ThirdPerson") then return end
                if LocalPlayer.CameraMode ~= Enum.CameraMode.Classic then
                    LocalPlayer.CameraMode = Enum.CameraMode.Classic
                end
            end), "thirdPerson")
        else
            Master:Remove("thirdPerson")

            if CameraState.savedMode then
                LocalPlayer.CameraMode = CameraState.savedMode
            end

            -- Unlock Camera Zoom owns the minimum while it is on, so leave its
            -- value alone and only restore the zoom this toggle overwrote.
            if not tog("UnlockZoom") then
                LocalPlayer.CameraMinZoomDistance = CameraState.savedMin or CameraState.defaultMin
            end

            CameraState.savedMode = nil
            CameraState.savedMin  = nil
        end
    end,
})

local WAYPOINT_PATH = CONFIG.SETTINGS_FOLDER .. "/waypoints_" .. tostring(game.PlaceId) .. ".json"
local waypoints = {}
local waypointDropdown

local function waypointNames()
    local names = {}
    for name in pairs(waypoints) do
        table.insert(names, name)
    end
    table.sort(names)
    return names
end

local function refreshWaypointDropdown()
    if not waypointDropdown then return end
    local names = waypointNames()
    if #names == 0 then names = { "(none)" } end
    pcall(function() waypointDropdown:SetValues(names) end)
end

local function saveWaypoints()
    if not Exec.hasFiles then return false end
    Exec.ensureFolder(CONFIG.SETTINGS_FOLDER)
    local serialised = {}
    for name, cf in pairs(waypoints) do
        serialised[name] = { cf:GetComponents() }
    end
    local ok, encoded = pcall(function() return HttpService:JSONEncode(serialised) end)
    if not ok then return false end
    return Exec.write(WAYPOINT_PATH, encoded)
end

local function loadWaypoints()
    if not Exec.hasFiles then return end
    local contents = Exec.read(WAYPOINT_PATH)
    if not contents then return end
    local ok, decoded = pcall(function() return HttpService:JSONDecode(contents) end)
    if not ok or typeof(decoded) ~= "table" then return end
    for name, components in pairs(decoded) do
        if typeof(components) == "table" and #components == 12 then
            waypoints[name] = CFrame.new(table.unpack(components))
        end
    end
end

loadWaypoints()

WaypointGroup:AddInput("WaypointName", {
    Text = "Waypoint name",
    Default = "",
    Placeholder = "e.g. hiding spot",
})

waypointDropdown = WaypointGroup:AddDropdown("WaypointList", {
    Values = (function()
        local names = waypointNames()
        return #names > 0 and names or { "(none)" }
    end)(),
    Default = 1,
    Multi = false,
    Text = "Saved waypoints",
})

Button(WaypointGroup, "Save Current Position", "Stores your position under the name above", function()
    local name = opt("WaypointName", "")
    if name == nil or name == "" then
        return notify("Type a waypoint name first.")
    end
    local _, root = Char.require()
    waypoints[name] = root.CFrame
    refreshWaypointDropdown()
    notify(saveWaypoints() and ("Saved waypoint '%s'."):format(name) or ("Saved '%s' (session only)."):format(name))
end)

Button(WaypointGroup, "Teleport To Waypoint", "Go to the selected waypoint", function()
    local name = opt("WaypointList")
    local cf = name and waypoints[name]
    if not cf then return notify("No waypoint selected.") end
    pushPosition()
    pivotTo(cf)
    notify("Teleported to " .. name)
end)

Button(WaypointGroup, "< Return", "Go back to your previous position", function()
    if popPosition() then
        notify("Returned to previous position")
    else
        notify("No saved position to return to.")
    end
end)

Button(WaypointGroup, "Delete Waypoint", nil, function()
    local name = opt("WaypointList")
    if not name or not waypoints[name] then return notify("No waypoint selected.") end
    waypoints[name] = nil
    refreshWaypointDropdown()
    saveWaypoints()
    notify("Deleted " .. name)
end)

Button(WaypointGroup, "Clear All Waypoints", nil, function()
    waypoints = {}
    refreshWaypointDropdown()
    Exec.delete(WAYPOINT_PATH)
    notify("All waypoints cleared.")
end)

local playerDropdown

local function playerNames()
    local names = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            table.insert(names, plr.Name)
        end
    end
    table.sort(names)
    if #names == 0 then names = { "(nobody)" } end
    return names
end

local function refreshPlayerDropdown()
    if not playerDropdown then return end
    pcall(function() playerDropdown:SetValues(playerNames()) end)
end

playerDropdown = PlayerGroup:AddDropdown("PlayerList", {
    Values = playerNames(),
    Default = 1,
    Multi = false,
    Text = "Player",
})

Button(PlayerGroup, "Refresh List", nil, function()
    refreshPlayerDropdown()
    notify("Player list refreshed.")
end)

Button(PlayerGroup, "Teleport To Player", "Go to the selected player", function()
    local name = opt("PlayerList")
    local target = name and Players:FindFirstChild(name)
    local targetRoot = target and target.Character and target.Character:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return notify("That player has no character right now.") end
    pushPosition()
    pivotTo(targetRoot.CFrame * CFrame.new(0, 0, 4))
    notify("Teleported to " .. name)
end)

Button(PlayerGroup, "< Return", "Go back to your previous position", function()
    if popPosition() then
        notify("Returned to previous position")
    else
        notify("No saved position to return to.")
    end
end)

