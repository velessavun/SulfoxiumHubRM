-- Every tracer line ever created, whether or not an entry still owns it. The
-- render pass hides all of these at the start of each frame and only valid
-- targets switch theirs back on, so a line cannot outlive its target no matter
-- which teardown path failed to run.
local ESP_TRACERS = {}

local ESP = {
    active  = {},
    enabled = {},
    running = false,
}

local ESP_NAME_CATEGORIES = {}
local ESP_PATTERN_CATEGORIES = {}

-- Anything sitting inside an object that is already highlighted is a duplicate
-- of it: a handle inside its own model, a frame part inside the bed it belongs
-- to, a gauge part inside the generator. Word matches count as well, otherwise
-- every plank of a bed frame would get its own outline.
local function notNestedInMatch(inst)
    local parent = inst.Parent
    while parent and parent ~= Workspace do
        if ESP_NAME_CATEGORIES[parent.Name] then return false end

        local lowerName
        for _, cat in ipairs(ESP_PATTERN_CATEGORIES) do
            lowerName = lowerName or parent.Name:lower()
            for _, word in ipairs(cat.patterns) do
                if lowerName:find(word, 1, true) then return false end
            end
        end

        parent = parent.Parent
    end
    return true
end

-- Answers the same question the Night 3 teleport does: is this can still there
-- to collect? Written self-contained because the Bunker helpers it mirrors are
-- defined much further down the file.
local function isLiveJerryCan(inst)
    -- Someone is carrying it.
    if inst:FindFirstAncestorOfClass("Backpack") then return false end
    local model = inst:FindFirstAncestorOfClass("Model")
    while model do
        if model:FindFirstChildOfClass("Humanoid") then return false end
        model = model:FindFirstAncestorOfClass("Model")
    end

    -- The cans under Cabins are scenery and never collectable.
    local parent = inst.Parent
    while parent and parent ~= Workspace do
        if parent.Name == "Cabins" then return false end
        parent = parent.Parent
    end

    -- An empty spawn point keeps an invisible placeholder; one that actually
    -- spawned has a part you can see.
    if inst:IsA("BasePart") then return inst.Transparency < 1 end
    for _, part in ipairs(inst:GetDescendants()) do
        if part:IsA("BasePart") and part.Transparency < 1 then return true end
    end
    return false
end

local ESP_CATEGORIES = {
    { key = "Players", text = "Players", default = Color3.fromRGB(80, 140, 255) },
    { key = "Larry", text = "Larry (Mutant)", default = Color3.fromRGB(255, 60, 60), names = { Mutant = true } },
    { key = "Stalker", text = "Stalker", default = Color3.fromRGB(255, 0, 200), names = { Stalker = true } },
    { key = "Zombies", text = "Zombies", default = Color3.fromRGB(120, 255, 120), names = { Zombie = true, BloodZombie = true, FrozenZombie = true, FrozenBloodZombie = true } },
    { key = "Abomination", text = "Abomination / Rat", default = Color3.fromRGB(255, 0, 255), names = { BunkerRat = true, Abomination = true, Monster = true } },
    { key = "Generators", text = "Generators", default = Color3.fromRGB(255, 170, 0), names = { Generator = true, Gen = true } },
    { key = "Monster", text = "Mutant Worker", default = Color3.fromRGB(255, 80, 0), names = { Mutant = true, Worker = true }, tab = "Night3" },
    { key = "WorkerHead", text = "WorkerHead", default = Color3.fromRGB(255, 230, 0), names = { WorkerHead = true }, tab = "Night3" },
    -- Replaces the old Fuel category, which matched any Model or part named
    -- Fuel or Gasoline and lit up spawn markers and generator internals. This
    -- one only counts cans that have actually spawned and are still there to
    -- collect, and that test holds in every place, so it lives here rather than
    -- in one tab.
    { key = "JerryCan", text = "JerryCan", default = Color3.fromRGB(0, 255, 120), names = { JerryCan = true }, filter = isLiveJerryCan },
    -- Wood and Log used to live here: they are not pickups, and bed frames are
    -- built out of parts using those names, which is why beds lit up too.
    { key = "Items", text = "Items / Pickups", default = Color3.fromRGB(255, 255, 120), names = { Battery = true, Flashlight = true, Medkit = true, Bandage = true, Key = true, Keycard = true, Marshmallow = true }, filter = notNestedInMatch },
    -- Beds are named inconsistently from map to map — the Bunker's did not match
    -- any exact spelling — so this one matches on the word instead. "bedroom" is
    -- excluded so a whole room does not light up.
    { key = "Beds", text = "Beds", default = Color3.fromRGB(120, 200, 255), names = { Bed = true, Beds = true, BunkBed = true, Bunk = true },
      patterns = { "bed", "bunk" }, excludes = { "bedroom" }, filter = notNestedInMatch },
}

local THREAT_KEYS = { Larry = true, Stalker = true, Zombies = true, Abomination = true, Monster = true }

-- name -> the categories claiming it. A sweep tests thousands of instances, so
-- matching has to be one hash lookup rather than a walk over every category's
-- name table. A name can belong to more than one category — "Mutant" is both
-- Larry and Monster — so this holds a list and the enabled one wins.
for _, cat in ipairs(ESP_CATEGORIES) do
    if cat.names then
        for name in pairs(cat.names) do
            local claimed = ESP_NAME_CATEGORIES[name]
            if claimed then
                table.insert(claimed, cat)
            else
                ESP_NAME_CATEGORIES[name] = { cat }
            end
        end
    end
end

-- Categories that also match on a word inside the name. Kept as its own short
-- list so the sweep only pays for the lowercase conversion when one of them is
-- actually switched on.
local ESP_CATEGORY_BY_KEY = {}
for _, cat in ipairs(ESP_CATEGORIES) do
    ESP_CATEGORY_BY_KEY[cat.key] = cat
    if cat.patterns then
        table.insert(ESP_PATTERN_CATEGORIES, cat)
    end
end

local function espColor(key)
    local value = opt("ESP_" .. key .. "Color")
    if value then return value end
    for _, cat in ipairs(ESP_CATEGORIES) do
        if cat.key == key then return cat.default end
    end
    return Color3.new(1, 1, 1)
end

-- Your own character is drawn in dark green so it never reads as another player.
local SELF_ESP_COLOR = Color3.fromRGB(0, 80, 20)

local function makeEspEntry(inst, key, label, colorOverride)
    local color = colorOverride or espColor(key)

    local highlight = Instance.new("Highlight")
    highlight.Name = "RMx_ESP"
    highlight.Adornee = inst
    highlight.FillColor = color
    highlight.FillTransparency = 0.6
    -- No outline at all: a fully transparent one leaves just the coloured fill,
    -- which reads far cleaner than the white edge that used to ring everything.
    highlight.OutlineTransparency = 1
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = hiddenUI

    -- Written out rather than as an and/or chain: when a Model had no Head, no
    -- PrimaryPart and no BasePart directly under it, that chain fell through to
    -- the Model itself, and reading .Position off a Model throws. The search is
    -- recursive now too, since a model like itemspots.spot.battery keeps its
    -- parts a level or two down.
    local adornPart
    if inst:IsA("BasePart") then
        adornPart = inst
    elseif inst:IsA("Model") then
        local head = inst:FindFirstChild("Head")
        if head and head:IsA("BasePart") then
            adornPart = head
        else
            adornPart = inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
        end
    end

    local billboard, textLabel
    if adornPart and adornPart:IsA("BasePart") then
        billboard = Instance.new("BillboardGui")
        billboard.Name = "RMx_ESPLabel"
        billboard.Adornee = adornPart
        billboard.Size = UDim2.new(0, 220, 0, 34)
        billboard.StudsOffset = Vector3.new(0, 2.5, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = hiddenUI

        textLabel = Instance.new("TextLabel")
        textLabel.BackgroundTransparency = 1
        textLabel.Size = UDim2.fromScale(1, 1)
        textLabel.Font = Enum.Font.GothamMedium
        textLabel.TextSize = 13
        textLabel.TextColor3 = color
        textLabel.TextStrokeTransparency = 0.4
        textLabel.Text = label or inst.Name
        textLabel.Parent = billboard
    end

    return {
        key           = key,
        label         = label or inst.Name,
        color         = color,
        colorOverride = colorOverride,
        highlight     = highlight,
        billboard     = billboard,
        text          = textLabel,
        adornPart     = adornPart,
        humanoid      = inst:IsA("Model") and inst:FindFirstChildOfClass("Humanoid") or nil,
        tracer        = nil,
    }
end

local function destroyTracer(entry)
    local tracer = entry.tracer
    if not tracer then return end
    entry.tracer = nil

    -- Hidden before it is removed, and never only removed: dropping the
    -- reference after a failed :Remove() would leave the line drawn with
    -- nothing left to hide it.
    pcall(function() tracer.Visible = false end)

    if not pcall(function() tracer:Remove() end) then
        pcall(function() tracer:Destroy() end)
    end

    ESP_TRACERS[tracer] = nil
end

local function removeEspEntry(inst)
    local entry = ESP.active[inst]
    if not entry then return end
    ESP.active[inst] = nil
    destroyItem(entry.highlight)
    destroyItem(entry.billboard)
    destroyTracer(entry)
end

local function addEspEntry(inst, key, label, colorOverride)
    ESP.active[inst] = makeEspEntry(inst, key, label, colorOverride)
end

local function matchesPattern(cat, lowerName)
    for _, word in ipairs(cat.excludes or {}) do
        if lowerName:find(word, 1, true) then return false end
    end
    for _, word in ipairs(cat.patterns) do
        if lowerName:find(word, 1, true) then return true end
    end
    return false
end

local function categoryFor(inst)
    -- Name first: it rejects almost every instance for the price of one lookup,
    -- where IsA is a call into the engine for each of the two class tests.
    local claimed = ESP_NAME_CATEGORIES[inst.Name]

    if claimed then
        if not inst:IsA("Model") and not inst:IsA("BasePart") then return nil end

        for _, cat in ipairs(claimed) do
            if ESP.enabled[cat.key] and (not cat.filter or cat.filter(inst)) then
                return cat.key
            end
        end
        return nil
    end

    -- Word matching, only for the categories that asked for it and only while
    -- one of them is switched on, so the usual sweep pays nothing for this.
    local lowerName
    for _, cat in ipairs(ESP_PATTERN_CATEGORIES) do
        if ESP.enabled[cat.key] then
            lowerName = lowerName or inst.Name:lower()
            if matchesPattern(cat, lowerName)
                and (inst:IsA("Model") or inst:IsA("BasePart"))
                and (not cat.filter or cat.filter(inst)) then
                return cat.key
            end
        end
    end
    return nil
end

local function considerInstance(inst)
    if ESP.active[inst] then return end
    local key = categoryFor(inst)
    if key then
        addEspEntry(inst, key)
    end
end

-- Cheap: at most a handful of players, safe to run every second. Your own
-- character is included so you get the same box, outline and name tag.
local function sweepPlayers()
    if not ESP.enabled.Players then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        local char = plr.Character
        if char and not ESP.active[char] then
            local isSelf = plr == LocalPlayer
            addEspEntry(char, "Players", plr.Name, isSelf and SELF_ESP_COLOR or nil)

            -- Marked so no tracer is drawn to your own character: the line would
            -- run from the centre of the screen to your own head and twitch with
            -- the idle animation.
            local entry = ESP.active[char]
            if entry then entry.isSelf = isSelf end
        end
    end
end

-- Expensive: builds an array of every instance in the map. Yields every
-- ESP_SWEEP_BUDGET instances so the cost lands across frames rather than as
-- one visible hitch, and only runs as an occasional resync.
local function sweepWorkspace()
    local processed = 0
    for _, inst in ipairs(Workspace:GetDescendants()) do
        if not ESP.running then return end
        considerInstance(inst)
        processed += 1
        if processed >= CONFIG.ESP_SWEEP_BUDGET then
            processed = 0
            RunService.Heartbeat:Wait()
        end
    end
    sweepPlayers()
end

-- Cheap enough to run ten times a second: one IsDescendantOf per entry, no
-- filters and no Workspace walk. This is what catches a target that was deleted
-- or moved out of the world, and takes its tracer and label with it.
local function dropDeadEntries()
    for inst in pairs(ESP.active) do
        if not inst:IsDescendantOf(Workspace) then
            removeEspEntry(inst)
        end
    end
end

local function pruneEsp()
    for inst, entry in pairs(ESP.active) do
        local cat = ESP_CATEGORY_BY_KEY[entry.key]

        -- The filter is re-run, not just checked once at creation: a JerryCan
        -- that has since been collected should lose its highlight.
        local stale = not inst:IsDescendantOf(Workspace)
            or not ESP.enabled[entry.key]
            or (cat and cat.filter and not cat.filter(inst))

        if stale then
            removeEspEntry(inst)
        end
    end
end

local nearestThreat = { name = nil, distance = math.huge }

local function startEsp()
    if ESP.running then return end
    ESP.running = true

    Master:Add(Workspace.DescendantAdded:Connect(function(inst)
        if not ESP.running then return end
        -- This fires for every part the game streams in, so reject non-matches
        -- here instead of paying for a deferred closure on each one.
        if not ESP_NAME_CATEGORIES[inst.Name] then return end
        task.defer(function()
            if inst.Parent then considerInstance(inst) end
        end)
    end), "espAdded")

    task.spawn(function()
        while ESP.running do
            pcall(dropDeadEntries)
            task.wait(0.1)
        end
    end)

    task.spawn(function()
        while ESP.running do
            pcall(sweepPlayers)
            pcall(pruneEsp)
            task.wait(CONFIG.ESP_PLAYER_INTERVAL)
        end
    end)

    task.spawn(function()
        while ESP.running do
            task.wait(CONFIG.ESP_SWEEP_INTERVAL)
            if ESP.running then pcall(sweepWorkspace) end
        end
    end)

    local accumulator = CONFIG.ESP_LABEL_INTERVAL
    Master:Add(RunService.RenderStepped:Connect(function(dt)
        local camera = Workspace.CurrentCamera
        local tracersOn = DrawingLib ~= nil and camera ~= nil and tog("ESPTracers")

        accumulator += dt
        local doLabels = accumulator >= CONFIG.ESP_LABEL_INTERVAL
        if doLabels then accumulator = 0 end

        -- Every line starts this frame hidden. Only a target that is still in
        -- the world and in range switches its own back on below, so a line left
        -- behind by a deleted target simply never comes back. This runs before
        -- any early return, so dying or losing the camera cannot freeze one
        -- on screen either.
        for drawing in pairs(ESP_TRACERS) do
            if not pcall(function() drawing.Visible = false end) then
                ESP_TRACERS[drawing] = nil
            end
        end

        -- With tracers off there is nothing to do on the frames between label
        -- updates, so do not walk the entry list on them at all.
        if not doLabels and not tracersOn then return end

        local root = Char.root()
        if not root then return end
        local origin = root.Position
        local maxDistance = opt("ESPDistance", CONFIG.ESP_MAX_DISTANCE)

        -- Tracers start from the middle of the screen, where the crosshair sits
        -- in first person, rather than from the bottom edge.
        local viewport = camera and camera.ViewportSize
        local tracerOrigin = viewport and Vector2.new(viewport.X / 2, viewport.Y / 2)

        -- A target just off the edge projects to a coordinate a little outside
        -- the viewport, which is what lets the line keep pointing at it. One
        -- near the edge of the frustum can project to an enormous number, so the
        -- endpoint is bounded to keep the line sane.
        local limitX = viewport and viewport.X * 3 or 6000
        local limitY = viewport and viewport.Y * 3 or 6000
        local closestName, closestDistance = nil, math.huge

        for inst, entry in pairs(ESP.active) do
            local part = entry.adornPart

            -- Descendant of Workspace, not merely "has a parent". A destroyed
            -- model leaves its parts parented to the dead model, and a monster
            -- removed by reparenting keeps a parent too — in both cases the old
            -- check saw it as alive and kept redrawing the line at its last
            -- position. IsDescendantOf is false for both.
            if part and inst:IsDescendantOf(Workspace) and part:IsDescendantOf(Workspace) then
                local distance = (part.Position - origin).Magnitude
                local visible = distance <= maxDistance

                if doLabels then
                    if THREAT_KEYS[entry.key] and distance < closestDistance then
                        closestName, closestDistance = entry.label, distance
                    end

                    if entry.billboard then
                        entry.billboard.Enabled = visible
                        if visible and entry.text then
                            local suffix = ""
                            if entry.humanoid and entry.humanoid.Parent then
                                suffix = (" | %d HP"):format(math.floor(entry.humanoid.Health))
                            end
                            entry.text.Text = ("%s  [%.2fm]%s"):format(entry.label, distance, suffix)
                        end
                    end
                end

                if tracersOn and visible and not entry.isSelf then
                    local tracer = entry.tracer

                    if not tracer and not entry.tracerFailed then
                        local ok, line = pcall(function() return DrawingLib.new("Line") end)
                        if ok and line then
                            line.Thickness = opt("TracerThickness", 1)
                            line.Transparency = 1
                            line.Color = entry.color
                            line.ZIndex = 1
                            entry.tracer = line
                            tracer = line
                            ESP_TRACERS[line] = true
                        else
                            -- Drawing is unavailable for this target; asking
                            -- again every frame would only burn time.
                            entry.tracerFailed = true
                        end
                    end

                    if tracer then
                        local point = camera:WorldToViewportPoint(part.Position)

                        -- Only the depth decides whether to draw. Behind the
                        -- camera the projection mirrors, so a line drawn from it
                        -- points at the opposite side of the screen — that was
                        -- the one case worth hiding. Being off to the side is
                        -- not: the line should keep pointing the way you need to
                        -- turn, which is what it now does.
                        if point.Z > 0 then
                            tracer.From = tracerOrigin
                            tracer.To = Vector2.new(
                                math.clamp(point.X, -limitX, limitX),
                                math.clamp(point.Y, -limitY, limitY)
                            )
                            tracer.Visible = true
                        end
                        -- No else: everything was hidden at the top of the frame.
                    end
                end
            else
                -- Target is gone: take the tracer and label with it this frame,
                -- rather than leaving them frozen until the next prune.
                removeEspEntry(inst)
            end
        end

        if doLabels then
            nearestThreat.name = closestName
            nearestThreat.distance = closestDistance
        end
    end), "espLabels")
end

local function stopEspIfIdle()
    for _, enabled in pairs(ESP.enabled) do
        if enabled then return end
    end
    ESP.running = false
    Master:Remove("espAdded")
    Master:Remove("espLabels")
    for inst in pairs(ESP.active) do
        removeEspEntry(inst)
    end
    nearestThreat.name = nil
    nearestThreat.distance = math.huge
end

-- Shared so a category can be placed in another tab's groupbox and still be a
-- normal ESP toggle. Categories tagged with a tab are built by that tab.
local function buildEspToggle(group, cat)
    local toggle = Toggle(group, "ESP_" .. cat.key, {
        Text = cat.text,
        Default = false,
        Callback = function(state)
            ESP.enabled[cat.key] = state
            if state then
                startEsp()
                spawnSafe(sweepWorkspace, "ESP sweep")
            else
                pruneEsp()
                stopEspIfIdle()
            end
        end,
    })

    pcall(function()
        toggle:AddColorPicker("ESP_" .. cat.key .. "Color", {
            Default = cat.default,
            Title = cat.text .. " colour",
            Callback = function(color)
                for _, entry in pairs(ESP.active) do
                    -- Your own character keeps its dark green whatever the
                    -- Players colour is set to.
                    if entry.key == cat.key and not entry.colorOverride then
                        entry.color = color
                        entry.highlight.FillColor = color
                        if entry.text then entry.text.TextColor3 = color end
                        if entry.tracer then entry.tracer.Color = color end
                    end
                end
            end,
        })
    end)

    return toggle
end

for _, cat in ipairs(ESP_CATEGORIES) do
    local hidden = cat.hideIn and cat.hideIn[game.PlaceId]
    if not cat.tab and not hidden then
        buildEspToggle(ESPGroup, cat)
    end
end

