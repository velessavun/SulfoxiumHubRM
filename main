local blinkParams = RaycastParams.new()
do
    local ok = pcall(function() blinkParams.FilterType = Enum.RaycastFilterType.Exclude end)
    if not ok then
        pcall(function() blinkParams.FilterType = Enum.RaycastFilterType.Blacklist end)
    end
end

local blinkAccumulator = 0
local speedLabelAccumulator = 0

Master:Add(RunService.Heartbeat:Connect(function(dt)
    local hum = Char.humanoid()
    if not hum then return end
    local root = Char.root()
    if not root then return end
    local char = hum.Parent

    local mode = opt("SpeedMode", SPEED_MODES[1])
    local speedOn = tog("SpeedEnabled")
    local blinkOn = speedOn and (mode == SPEED_MODES[1] or mode == SPEED_MODES[3])
    local classicOn = speedOn and (mode == SPEED_MODES[2] or mode == SPEED_MODES[3])

    if blinkOn then
        blinkAccumulator += dt
        local interval = opt("BlinkInterval", 0.07)
        if blinkAccumulator >= interval then
            blinkAccumulator = 0
            local direction = hum.MoveDirection
            if direction.Magnitude > 0.05 then
                local step = opt("BlinkDistance", 4)
                local unit = direction.Unit
                local delta = unit * step

                if not (tog("Noclip") or tog("BlinkPhase")) then
                    blinkParams.FilterDescendantsInstances = { char }
                    local hit = Workspace:Raycast(root.Position, delta, blinkParams)
                    if hit then
                        local usable = (hit.Position - root.Position).Magnitude - 2
                        delta = usable > 0 and unit * usable or Vector3.zero
                    end
                end

                if delta.Magnitude > 0.01 then
                    local vertical = root.AssemblyLinearVelocity.Y
                    root.CFrame = root.CFrame + delta
                    root.AssemblyLinearVelocity = Vector3.new(0, vertical, 0)
                end
            end
        end
    end

    if classicOn then
        local target = baseWalkSpeed * opt("SpeedMultiplier", 3)
        if math.abs(hum.WalkSpeed - target) > 0.05 then
            hum.WalkSpeed = target
        end
    elseif speedOn and math.abs(hum.WalkSpeed - baseWalkSpeed) > 0.05 then
        hum.WalkSpeed = baseWalkSpeed
    end

    if tog("SprintEnabled") and char then
        char:SetAttribute("SprintSpeed", hum.WalkSpeed * opt("SprintMultiplier", 1.5))
    end

    if tog("JumpEnabled") then
        local power = opt("JumpPower", 75)
        hum.UseJumpPower = true
        if math.abs(hum.JumpPower - power) > 0.5 then
            hum.JumpPower = power
        end
    end

    if tog("AntiFling") then
        local velocity = root.AssemblyLinearVelocity
        if velocity.Magnitude > 250 then
            root.AssemblyLinearVelocity = velocity.Unit * 60
            root.AssemblyAngularVelocity = Vector3.zero
        end
    end

    if tog("AntiRagdoll") then
        if hum.PlatformStand then hum.PlatformStand = false end
        local state = hum:GetState()
        if state == Enum.HumanoidStateType.FallingDown or state == Enum.HumanoidStateType.Ragdoll then
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end

    speedLabelAccumulator += dt
    if speedLabelAccumulator >= 0.4 then
        speedLabelAccumulator = 0
        if speedOn and (mode == SPEED_MODES[1] or mode == SPEED_MODES[3]) then
            local effective = opt("BlinkDistance", 4) / math.max(opt("BlinkInterval", 0.07), 0.01)
            setLabel(speedLabel, ("Effective speed: %.0f studs/s"):format(effective + (classicOn and hum.WalkSpeed or 0)))
        else
            setLabel(speedLabel, ("Effective speed: %.0f studs/s"):format(hum.WalkSpeed))
        end
    end
end))

local Survival = {}
local SurvivalState = {}

function Survival.infiniteStamina()
    local char = Char.get()
    if not char then return false end
    local sprint = char:FindFirstChild("Sprint")
    local stam = sprint and sprint:FindFirstChild("Stam")
    if not stam then return false end

    if not SurvivalState.stam or SurvivalState.stam.inst ~= stam then
        SurvivalState.stam = {
            inst  = stam,
            max   = stam:GetAttribute("Max"),
            value = stam.Value,
        }
    end

    stam:SetAttribute("Max", CONFIG.INF_VALUE)
    stam.Value = CONFIG.INF_VALUE
    return true
end

function Survival.restoreStamina()
    local saved = SurvivalState.stam
    SurvivalState.stam = nil
    if not saved or not saved.inst.Parent then return false end
    pcall(function()
        saved.inst:SetAttribute("Max", saved.max)
        saved.inst.Value = saved.value
    end)
    return true
end

function Survival.infiniteOxygen()
    local char = Char.get()
    if not char then return false end
    local breath = char:FindFirstChild("Breath")
    if not breath then return false end

    local blur = Lighting:FindFirstChild("Blur")
    local sounds = Workspace:FindFirstChild("Sounds")
    local breathSfx = sounds and sounds:FindFirstChild("HeavyBreath")

    if not SurvivalState.breath or SurvivalState.breath.inst ~= breath then
        local blurEnabled, sfxLooped
        if blur then blurEnabled = blur.Enabled end
        if breathSfx then sfxLooped = breathSfx.Looped end

        SurvivalState.breath = {
            inst      = breath,
            max       = breath:GetAttribute("Max"),
            value     = breath.Value,
            blur      = blur,
            blurOn    = blurEnabled,
            sfx       = breathSfx,
            sfxLooped = sfxLooped,
        }
    end

    breath:SetAttribute("Max", CONFIG.INF_VALUE)
    breath.Value = CONFIG.INF_VALUE

    if blur then blur.Enabled = false end

    if breathSfx then
        breathSfx.Looped = false
        breathSfx.Playing = false
    end
    return true
end

function Survival.restoreOxygen()
    local saved = SurvivalState.breath
    SurvivalState.breath = nil
    if not saved then return false end

    pcall(function()
        if saved.inst.Parent then
            saved.inst:SetAttribute("Max", saved.max)
            saved.inst.Value = saved.value
        end
    end)
    pcall(function()
        if saved.blur and saved.blur.Parent and saved.blurOn ~= nil then
            saved.blur.Enabled = saved.blurOn
        end
    end)
    pcall(function()
        if saved.sfx and saved.sfx.Parent and saved.sfxLooped ~= nil then
            saved.sfx.Looped = saved.sfxLooped
        end
    end)
    return true
end

function Survival.disableCold()
    local char = Char.get()
    if not char then return false end
    local temp = char:FindFirstChild("Temperature")
    if not temp then return false end
    SurvivalState.cold = temp
    temp.Enabled = false
    return true
end

function Survival.enableCold()
    local char = Char.get()
    local temp = SurvivalState.cold or (char and char:FindFirstChild("Temperature"))
    SurvivalState.cold = nil
    if not temp or not temp.Parent then return false end
    temp.Enabled = true
    return true
end

function Survival.disableDeathHandler()
    local scripts = LocalPlayer:FindFirstChild("PlayerScripts")
    local handler = scripts and scripts:FindFirstChild("DeathHandler")
    if not handler then return false end
    SurvivalState.deathHandler = handler
    handler.Enabled = false
    return true
end

function Survival.enableDeathHandler()
    local scripts = LocalPlayer:FindFirstChild("PlayerScripts")
    local handler = SurvivalState.deathHandler or (scripts and scripts:FindFirstChild("DeathHandler"))
    SurvivalState.deathHandler = nil
    if not handler or not handler.Parent then return false end
    handler.Enabled = true
    return true
end

function Survival.topUpHealth()
    local hum = Char.humanoid()
    if not hum or hum.Health <= 0 then return false end
    if hum.Health < hum.MaxHealth then
        hum.Health = hum.MaxHealth
    end
    return true
end

local function survivalButton(text, tooltip, apply, revert, successMsg, revertMsg)
    return ToggleButton(SurvivalGroup, text, tooltip, function()
        if apply() then
            notify(successMsg)
            return true
        end
        notify("Not available in this place / not spawned yet.")
        return false
    end, function()
        revert()
        notify(revertMsg)
    end)
end

survivalButton("Infinite Stamina",
    "Sets Sprint.Stam to a huge value — press again to put the original value back",
    Survival.infiniteStamina, Survival.restoreStamina,
    "Infinite stamina applied.", "Stamina restored to normal.")

survivalButton("Infinite Oxygen",
    "Sets Breath to a huge value and kills the blur — press again to put it back",
    Survival.infiniteOxygen, Survival.restoreOxygen,
    "Infinite oxygen applied.", "Oxygen restored to normal.")

survivalButton("Disable Cold",
    "Disables the Temperature script — press again to re-enable it",
    Survival.disableCold, Survival.enableCold,
    "Freeze script disabled.", "Freeze script re-enabled.")

survivalButton("Disable DeathHandler",
    "Disables the DeathHandler LocalScript — press again to re-enable it",
    Survival.disableDeathHandler, Survival.enableDeathHandler,
    "DeathHandler disabled.", "DeathHandler re-enabled.")

Toggle(SurvivalGroup, "SurvivalLoop", {
    Text = "Keep Survival Stats Maxed",
    Default = false,
    Tooltip = "Re-applies stamina, oxygen and cold immunity on a timer",
    Callback = function(state)
        if not state then return end
        spawnSafe(function()
            while tog("SurvivalLoop") do
                pcall(Survival.infiniteStamina)
                pcall(Survival.infiniteOxygen)
                pcall(Survival.disableCold)
                task.wait(CONFIG.SURVIVAL_INTERVAL)
            end
        end, "Survival loop")
    end,
})

Toggle(SurvivalGroup, "AutoHeal", {
    Text = "Auto Heal",
    Default = false,
    Tooltip = "Restores health whenever it drops below maximum",
    Callback = function(state)
        if not state then return end
        spawnSafe(function()
            while tog("AutoHeal") do
                pcall(Survival.topUpHealth)
                task.wait(0.5)
            end
        end, "Auto heal")
    end,
})

Toggle(SurvivalGroup, "AutoRespawn", {
    Text = "Auto Respawn",
    Default = false,
    Tooltip = "Fires LoadCharacter shortly after you die",
    Callback = function(state)
        if state then
            local hum = Char.humanoid()
            if hum then
                Master:Add(hum.Died:Connect(function()
                    if not tog("AutoRespawn") then return end
                    task.wait(2)
                    fireRemote("LoadCharacter")
                end), "autoRespawn")
            end
        else
            Master:Remove("autoRespawn")
        end
    end,
})

Toggle(SurvivalGroup, "AutoReapply", {
    Text = "Re-apply on respawn",
    Default = true,
    Tooltip = "Automatically restores stamina/oxygen/cold immunity after you respawn",
})

local respawnHooks = {}

local function onCharacterAdded(char)
    char:WaitForChild("HumanoidRootPart", 10)
    char:WaitForChild("Humanoid", 10)
    task.wait(0.5)

    captureBaseStats()
    Collision.onRespawn()

    if tog("AutoRespawn") then
        local hum = Char.humanoid()
        if hum then
            Master:Add(hum.Died:Connect(function()
                if not tog("AutoRespawn") then return end
                task.wait(2)
                fireRemote("LoadCharacter")
            end), "autoRespawn")
        end
    end

    if tog("AutoReapply") then
        pcall(Survival.infiniteStamina)
        pcall(Survival.infiniteOxygen)
        pcall(Survival.disableCold)
    end

    for _, hook in ipairs(respawnHooks) do
        pcall(hook)
    end
end

Master:Add(LocalPlayer.CharacterAdded:Connect(function(char)
    spawnSafe(function() onCharacterAdded(char) end, "respawn handler")
end))

if LocalPlayer.Character then
    captureBaseStats()
end

ToggleButton(BypassGroup, "Anti-Cheat Bypass",
    "Renames the Kick remote and disables AC LocalScripts — press again to put them back",
    function()
        local swapped, count = ACSuppressor.run()
        notify(("Bypass applied. Kick remote: %s | scripts disabled: %d")
            :format(swapped and "swapped" or "not found", count), 5)
    end,
    function()
        local restored = ACSuppressor.restore()
        notify(("Bypass reverted. Kick remote restored | scripts re-enabled: %d")
            :format(restored), 5)
    end,
    { default = true, keepOnReset = true })

local closetBarriers = {}

ToggleButton(BypassGroup, "Remove Closet Barriers",
    "Detaches the Ignore part blocking closets — press again to put them back",
    function()
        local removed = 0
        for _, obj in ipairs(Workspace:GetChildren()) do
            if obj.Name == "Closet" then
                local ignore = obj:FindFirstChild("Ignore")
                if ignore then
                    table.insert(closetBarriers, { inst = ignore, parent = obj })
                    ignore.Parent = nil
                    removed += 1
                end
            end
        end
        notify(("Cleared %d closet barrier(s)."):format(removed))
    end,
    function()
        local restored = 0
        for _, entry in ipairs(closetBarriers) do
            if entry.parent and entry.parent.Parent then
                if pcall(function() entry.inst.Parent = entry.parent end) then
                    restored += 1
                end
            end
        end
        closetBarriers = {}
        notify(("Restored %d closet barrier(s)."):format(restored))
    end)

Toggle(BypassGroup, "AutoWire", {
    Text = "Auto-Wire",
    Default = false,
    Tooltip = "Automatically clicks sparking wires in the fuse box",
    Callback = function(state)
        if not state then return end
        spawnSafe(function()
            while tog("AutoWire") do
                local folder = remotes()
                local clickWire = folder and folder:FindFirstChild("ClickWire")
                if not clickWire then
                    notify("ClickWire remote missing — Auto-Wire disabled.", 5)
                    setToggle("AutoWire", false)
                    return
                end

                local fuseBox = Workspace:FindFirstChild("FuseBox")
                local wires = fuseBox and fuseBox:FindFirstChild("Wires")
                if wires then
                    for _, wire in ipairs(wires:GetChildren()) do
                        if not tog("AutoWire") then return end
                        local sparkles = wire:FindFirstChild("Sparkles")
                        if sparkles and sparkles.Enabled then
                            clickWire:FireServer(wire)
                            task.wait(0.5)
                        end
                    end
                end
                task.wait(0.4)
            end
        end, "AutoWire")
    end,
})

Toggle(BypassGroup, "AutoPrompt", {
    Text = "Auto Interact",
    Default = false,
    Tooltip = "Fires every ProximityPrompt within range automatically",
    Callback = function(state)
        if not state then return end
        if not Exec.hasPrompt then
            notify("Executor has no fireproximityprompt — Auto Interact disabled.", 5)
            setToggle("AutoPrompt", false)
            return
        end
        spawnSafe(function()
            while tog("AutoPrompt") do
                local root = Char.root()
                if root then
                    local range = opt("PromptRange", 18)
                    for _, inst in ipairs(Workspace:GetDescendants()) do
                        if not tog("AutoPrompt") then return end
                        if inst:IsA("ProximityPrompt") and inst.Enabled then
                            local parent = inst.Parent
                            local pos = parent and worldPosition(parent)
                            if pos and (pos - root.Position).Magnitude <= range then
                                Exec.proximityPrompt(inst)
                            end
                        end
                    end
                end
                task.wait(CONFIG.PROMPT_INTERVAL)
            end
        end, "Auto interact")
    end,
})

