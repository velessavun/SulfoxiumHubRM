    round(sidebar, 6)
    edge(sidebar, THEME.border, 0.45)
    padding(sidebar, 5)
    make("UIListLayout", { Padding = UDim.new(0, 15), SortOrder = Enum.SortOrder.LayoutOrder }, sidebar)

    local contentHolder = make("Frame", {
        Position = UDim2.fromOffset(SIDEBAR + 16, 42),
        Size = UDim2.new(1, -(SIDEBAR + 24), 1, -50),
        BackgroundColor3 = THEME.panel,
        BackgroundTransparency = 0.6,
    }, window)
    round(contentHolder, 6)
    edge(contentHolder, THEME.border, 0.45)

    -- The reference puts the current section's name in red across the top of
    -- the content pane; this is that line.
    local contentHeader = make("TextLabel", {
        Position = UDim2.fromOffset(0, 6),
        Size = UDim2.new(1, 0, 0, 22),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        TextSize = 17,
        TextColor3 = THEME.accent,
        Text = "Select a tab",
    }, contentHolder)

    -- Dragging by the title bar.
    do
        local dragging, startPos, startInput
        titleBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                startPos = window.Position
                startInput = input.Position
            end
        end)

        Master:Add(UserInputService.InputChanged:Connect(function(input)
            if not dragging then return end
            if input.UserInputType ~= Enum.UserInputType.MouseMovement
                and input.UserInputType ~= Enum.UserInputType.Touch then return end
            local delta = input.Position - startInput
            window.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end))

        Master:Add(UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end))
    end

    -- Show button and the pop animation ---------------------------------------

    local shown = false

    local showButton = round(make("TextButton", {
        AnchorPoint = Vector2.new(0.5, 0),
        -- Sits below the game's clock rather than beside it.
        Position = UDim2.new(0.5, 0, 0, 92),
        Size = UDim2.fromOffset(285, 51),
        BackgroundColor3 = THEME.row,
        BackgroundTransparency = 0.2,
        Font = Enum.Font.GothamBold,
        TextSize = 22,
        TextColor3 = THEME.text,
        Text = "Show Sulfoxium",
        AutoButtonColor = false,
    }, screen), 10)
    edge(showButton, THEME.border, 0.35)

    -- First person locks the cursor to the middle of the screen, which leaves
    -- nothing to click the menu with. It is freed while the menu is open and put
    -- back exactly as it was on close. The camera script re-locks it every frame
    -- in first person, so this has to be re-asserted every frame to win.
    local savedBehavior, savedIcon

    local function freeCursor(free)
        if free then
            if savedBehavior == nil then
                savedBehavior = UserInputService.MouseBehavior
                savedIcon = UserInputService.MouseIconEnabled
            end

            Master:Add(RunService.RenderStepped:Connect(function()
                -- Hold right mouse to look around. The camera takes the mouse
                -- itself while you drag, and forcing it free every frame is what
                -- stopped the view from turning, so the override stands down for
                -- as long as the button is down and resumes the moment it is up.
                local looking = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)

                if not looking and UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default then
                    UserInputService.MouseBehavior = Enum.MouseBehavior.Default
                end

                if not UserInputService.MouseIconEnabled then
                    UserInputService.MouseIconEnabled = true
                end
            end), "freeCursor")
        else
            Master:Remove("freeCursor")
            if savedBehavior ~= nil then
                pcall(function() UserInputService.MouseBehavior = savedBehavior end)
                pcall(function() UserInputService.MouseIconEnabled = savedIcon end)
                savedBehavior, savedIcon = nil, nil
            end
        end
    end

    local function setShown(state)
        shown = state
        showButton.Text = state and "Hide Sulfoxium" or "Show Sulfoxium"
        freeCursor(state)

        if state then
            window.Visible = true
            window.Size = UDim2.fromOffset(0, 0)
            -- Anchored at the centre, so growing the size opens it out from the
            -- middle of the screen rather than from a corner.
            tween(window, 0.22, { Size = UDim2.fromOffset(WINDOW.X, WINDOW.Y) })
        else
            local animation = tween(window, 0.18, { Size = UDim2.fromOffset(0, 0) })
            if animation then
                animation.Completed:Connect(function()
                    if not shown then window.Visible = false end
                end)
            else
                window.Visible = false
            end
        end
    end

    showButton.MouseButton1Click:Connect(function()
        setShown(not shown)
    end)

    showButton.MouseEnter:Connect(function()
        tween(showButton, 0.12, { BackgroundColor3 = THEME.rowLit })
    end)
    showButton.MouseLeave:Connect(function()
        tween(showButton, 0.12, { BackgroundColor3 = THEME.row })
    end)

    -- Notifications -----------------------------------------------------------

    local notifyHolder = make("Frame", {
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -14, 1, -14),
        Size = UDim2.fromOffset(260, 300),
        BackgroundTransparency = 1,
