                    notify("Larry despawned.", 4)
                end
            end), "notifierRemove")
            notify("Spawn notifier enabled.")
        else
            Master:Remove("notifierAdd")
            Master:Remove("notifierRemove")
            notify("Spawn notifier disabled.")
        end
    end,
})

