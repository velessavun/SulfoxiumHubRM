        SortOrder = Enum.SortOrder.LayoutOrder,
        VerticalAlignment = Enum.VerticalAlignment.Bottom,
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
    }, notifyHolder)

    local function showNotification(text, duration)
        local card = round(make("Frame", {
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundColor3 = THEME.panel,
            BackgroundTransparency = 0.15,
        }, notifyHolder), 10)
        edge(card, THEME.accent, 0.45)
        padding(card, 10)

        make("TextLabel", {
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            Font = Enum.Font.Gotham,
            TextSize = 16,
            TextColor3 = THEME.text,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextWrapped = true,
            Text = text,
        }, card)

        task.delay(duration, function()
            tween(card, 0.2, { BackgroundTransparency = 1 })
            task.wait(0.22)
            pcall(function() card:Destroy() end)
        end)
    end

    -- Elements ----------------------------------------------------------------

    local function increment(rounding)
        if not rounding or rounding <= 0 then return 1 end
        return 1 / (10 ^ rounding)
    end

    local function register(store, id, value)
        local entry = store[id]
        if not entry then
            entry = {}
            store[id] = entry
        end
        entry.Value = value
        return entry
    end

    local function row(parent, height)
        local frame = round(make("Frame", {
            Size = UDim2.new(1, 0, 0, height or 38),
            BackgroundColor3 = THEME.row,
            BackgroundTransparency = 0.3,
        }, parent), 8)
        edge(frame, THEME.deep, 0.55)
        return frame
    end

    local function rowLabel(parent, text, width)
        return make("TextLabel", {
            Position = UDim2.fromOffset(10, 0),
            Size = width or UDim2.new(1, -20, 1, 0),
            BackgroundTransparency = 1,
            Font = Enum.Font.Gotham,
            TextSize = 16,
            TextColor3 = THEME.text,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Text = text,
        }, parent)
    end

    -- A slider bar shared by the sliders and the colour picker channels.
    local function bar(parent, position, size, min, max, rounding, initial, onChange)
        local track = round(make("Frame", {
            AnchorPoint = Vector2.new(0, 0.5),
            Position = position,
            Size = size,
            BackgroundColor3 = THEME.black,
            BackgroundTransparency = 0.2,
        }, parent), 6)

        local fill = round(make("Frame", {
            Size = UDim2.fromScale(0, 1),
            BackgroundColor3 = THEME.accent,
            BorderSizePixel = 0,
        }, track), 6)

        local value = initial
        local step = increment(rounding)

        local function apply(newValue, fire)
            value = math.clamp(newValue, min, max)
            value = math.floor(value / step + 0.5) * step
            local span = max - min
            fill.Size = UDim2.fromScale(span > 0 and (value - min) / span or 0, 1)
            if fire then onChange(value) end
        end

        apply(initial, false)

        local dragging = false
        local function fromInput(input)
            if track.AbsoluteSize.X <= 0 then return end
            local alpha = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            apply(min + (max - min) * alpha, true)
        end

        track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                fromInput(input)
            end
        end)

        Master:Add(UserInputService.InputChanged:Connect(function(input)
            if not dragging then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch then
                fromInput(input)
            end
        end))

        Master:Add(UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end))

        return { set = function(v) apply(v, false) end }
    end

    -- Groups ------------------------------------------------------------------

    local function newGroup(page, state, title)
        local group = {}

        local function open()
            if state.current == group then return end
            state.current = group

            local header = make("TextLabel", {
                Size = UDim2.new(1, 0, 0, 24),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBold,
                TextSize = 16,
                TextColor3 = THEME.accent,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = string.upper(title),
                LayoutOrder = state.order,
            }, page)
            state.order += 1
            return header
        end

        local function place(inst)
            inst.LayoutOrder = state.order
            state.order += 1
            inst.Parent = page
        end

        function group:AddButton(a, b)
            open()
            local text, func
            if typeof(a) == "table" then
                text, func = a.Text, a.Func
            else
                text, func = a, b
            end

            local button = round(make("TextButton", {
                Size = UDim2.new(1, 0, 0, 38),
                BackgroundColor3 = THEME.row,
                BackgroundTransparency = 0.3,
                Font = Enum.Font.Gotham,
                TextSize = 16,
                TextColor3 = THEME.text,
                Text = text,
                AutoButtonColor = false,
            }), 8)
            edge(button, THEME.deep, 0.55)
            place(button)

            button.MouseEnter:Connect(function()
                tween(button, 0.1, { BackgroundColor3 = THEME.rowLit })
            end)
            button.MouseLeave:Connect(function()
                tween(button, 0.1, { BackgroundColor3 = THEME.row })
            end)
            button.MouseButton1Click:Connect(function()
                if func then task.spawn(func) end
            end)

            return {
                SetText = function(_, newText) button.Text = newText end,
            }
        end

        function group:AddToggle(id, info)
            open()
            local entry = register(Toggles, id, info.Default == true)

            local frame = row(page)
            place(frame)
            rowLabel(frame, info.Text, UDim2.new(1, -60, 1, 0))

            local pill = round(make("Frame", {
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -10, 0.5, 0),
                Size = UDim2.fromOffset(42, 20),
                BackgroundColor3 = THEME.black,
                BackgroundTransparency = 0.2,
            }, frame), 10)

            local knob = round(make("Frame", {
                AnchorPoint = Vector2.new(0, 0.5),
                Position = UDim2.new(0, 2, 0.5, 0),
                Size = UDim2.fromOffset(16, 16),
                BackgroundColor3 = THEME.dim,
            }, pill), 6)

            local hit = make("TextButton", {
                Size = UDim2.fromScale(1, 1),
                BackgroundTransparency = 1,
                Text = "",
            }, frame)

            local function paint()
                if entry.Value then
                    tween(knob, 0.12, { Position = UDim2.new(1, -18, 0.5, 0), BackgroundColor3 = THEME.text })
                else
                    tween(knob, 0.12, { Position = UDim2.new(0, 2, 0.5, 0), BackgroundColor3 = THEME.dim })
                end
            end
            paint()

            -- Fires the callback even when the value did not change: the script
            -- switches some toggles to their existing default at startup to make
            -- the feature attach itself, and swallowing that would leave Anti-AFK
            -- and friends showing on but doing nothing.
            local function set(value, fire)
                value = value == true
                if entry.Value ~= value then
                    entry.Value = value
                    paint()
                end
                if fire and info.Callback then task.spawn(info.Callback, value) end
            end

            hit.MouseButton1Click:Connect(function()
                set(not entry.Value, true)
            end)

            entry.SetValue = function(_, value) set(value, true) end

            -- Only toggles that asked for a real key get a bind, and it lives in
            -- the input listener rather than as an element.
            entry.AddKeyPicker = function(_, keyId, keyInfo)
                local default = keyInfo and keyInfo.Default
                if not default or default == "None" then return end
                KEYBINDS[default] = function() set(not entry.Value, true) end
            end

            entry.AddColorPicker = function(_, colorId, colorInfo)
                local colorEntry = register(Options, colorId, colorInfo.Default)

                local pickerRow = row(page)
                place(pickerRow)
                rowLabel(pickerRow, colorInfo.Title or colorId, UDim2.new(1, -60, 1, 0))

                local swatch = round(make("Frame", {
                    AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, -10, 0.5, 0),
                    Size = UDim2.fromOffset(34, 16),
                    BackgroundColor3 = colorInfo.Default,
                }, pickerRow), 6)
                edge(swatch, THEME.deep, 0.3)

                local channels = make("Frame", {
                    Size = UDim2.new(1, 0, 0, 66),
                    BackgroundTransparency = 1,
                    Visible = false,
                }, page)
                place(channels)

                local rgb = { colorInfo.Default.R * 255, colorInfo.Default.G * 255, colorInfo.Default.B * 255 }

                local function push()
                    local color = Color3.fromRGB(rgb[1], rgb[2], rgb[3])
                    swatch.BackgroundColor3 = color
                    colorEntry.Value = color
                    if colorInfo.Callback then task.spawn(colorInfo.Callback, color) end
                end

                for index, name in ipairs({ "R", "G", "B" }) do
                    local line = make("Frame", {
                        Position = UDim2.fromOffset(0, (index - 1) * 22),
                        Size = UDim2.new(1, 0, 0, 20),
                        BackgroundTransparency = 1,
                    }, channels)

                    make("TextLabel", {
                        Size = UDim2.fromOffset(18, 20),
                        BackgroundTransparency = 1,
                        Font = Enum.Font.Gotham,
                        TextSize = 12,
                        TextColor3 = THEME.dim,
                        Text = name,
                    }, line)

                    bar(line, UDim2.new(0, 22, 0.5, 0), UDim2.new(1, -32, 0, 8), 0, 255, 0, rgb[index], function(value)
                        rgb[index] = value
                        push()
                    end)
                end

                colorEntry.SetValue = function(_, value)
                    if typeof(value) ~= "Color3" then return end
                    rgb = { value.R * 255, value.G * 255, value.B * 255 }
                    push()
                end

                local swatchHit = make("TextButton", {
                    Size = UDim2.fromScale(1, 1),
                    BackgroundTransparency = 1,
                    Text = "",
                }, pickerRow)

                swatchHit.MouseButton1Click:Connect(function()
                    channels.Visible = not channels.Visible
                end)
            end

            return entry
        end

        function group:AddSlider(id, info)
            open()
            local entry = register(Options, id, info.Default)

            local frame = row(page, 54)
            place(frame)

            local caption = rowLabel(frame, info.Text, UDim2.new(1, -20, 0, 24))
            caption.TextYAlignment = Enum.TextYAlignment.Top

            local readout = make("TextLabel", {
                AnchorPoint = Vector2.new(1, 0),
                Position = UDim2.new(1, -10, 0, 0),
                Size = UDim2.new(0, 110, 0, 24),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBold,
                TextSize = 15,
                TextColor3 = THEME.accent,
                TextXAlignment = Enum.TextXAlignment.Right,
                Text = "",
            }, frame)

            local decimals = info.Rounding or 0
            local function show(value)
                readout.Text = ("%." .. decimals .. "f%s"):format(value, info.Suffix or "")
            end
            show(info.Default)

            local handle = bar(frame, UDim2.new(0, 10, 1, -16), UDim2.new(1, -20, 0, 10),
                info.Min, info.Max, info.Rounding, info.Default, function(value)
                    entry.Value = value
                    show(value)
                    if info.Callback then task.spawn(info.Callback, value) end
                end)

            -- Used when a saved config is applied.
            entry.SetValue = function(_, value)
                if typeof(value) ~= "number" then return end
                entry.Value = value
                handle.set(value)
                show(value)
                if info.Callback then task.spawn(info.Callback, value) end
            end

            return entry
        end

        function group:AddDropdown(id, info)
            open()
            local values = info.Values or {}
            local entry = register(Options, id, values[info.Default or 1])

            local frame = row(page)
            place(frame)
            rowLabel(frame, info.Text, UDim2.new(0.5, -10, 1, 0))

            local current = make("TextLabel", {
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -10, 0.5, 0),
                Size = UDim2.new(0.5, -10, 1, 0),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBold,
                TextSize = 15,
                TextColor3 = THEME.text,
                TextXAlignment = Enum.TextXAlignment.Right,
                TextTruncate = Enum.TextTruncate.AtEnd,
                Text = tostring(entry.Value or "(none)"),
            }, frame)

            local list = make("Frame", {
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                Visible = false,
            }, page)
            place(list)
            make("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, list)

            local function rebuild(newValues)
                for _, child in ipairs(list:GetChildren()) do
                    if child:IsA("TextButton") then child:Destroy() end
                end

                for _, value in ipairs(newValues) do
                    local option = round(make("TextButton", {
                        Size = UDim2.new(1, 0, 0, 30),
                        BackgroundColor3 = THEME.row,
                        BackgroundTransparency = 0.4,
                        Font = Enum.Font.Gotham,
                        TextSize = 15,
                        TextColor3 = THEME.text,
                        Text = tostring(value),
                        AutoButtonColor = false,
                    }, list), 6)

                    option.MouseButton1Click:Connect(function()
                        entry.Value = value
                        current.Text = tostring(value)
                        list.Visible = false
                        if info.Callback then task.spawn(info.Callback, value) end
                    end)
                end
            end

            rebuild(values)

            local hit = make("TextButton", {
                Size = UDim2.fromScale(1, 1),
                BackgroundTransparency = 1,
                Text = "",
            }, frame)
            hit.MouseButton1Click:Connect(function()
                list.Visible = not list.Visible
            end)

            entry.SetValue = function(_, value)
                entry.Value = value
                current.Text = tostring(value)
                if info.Callback then task.spawn(info.Callback, value) end
            end

            entry.SetValues = function(_, newValues)
                rebuild(newValues)
                local stillThere = false
                for _, value in ipairs(newValues) do
                    if value == entry.Value then stillThere = true break end
                end
                if not stillThere then
                    entry.Value = newValues[1]
                    current.Text = tostring(entry.Value or "(none)")
                end
            end

            return entry
        end

        function group:AddInput(id, info)
            open()
            local entry = register(Options, id, info.Default or "")

            local frame = row(page)
            place(frame)
            rowLabel(frame, info.Text, UDim2.new(0.45, -10, 1, 0))

            local box = round(make("TextBox", {
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -8, 0.5, 0),
                Size = UDim2.new(0.5, 0, 0, 26),
                BackgroundColor3 = THEME.black,
                BackgroundTransparency = 0.2,
                Font = Enum.Font.Gotham,
                TextSize = 15,
                TextColor3 = THEME.text,
                PlaceholderText = info.Placeholder or "",
                PlaceholderColor3 = THEME.dim,
                Text = info.Default or "",
                ClearTextOnFocus = false,
            }, frame), 6)

            box.FocusLost:Connect(function()
                entry.Value = box.Text
                if info.Callback then task.spawn(info.Callback, box.Text) end
            end)

            entry.SetValue = function(_, value)
                entry.Value = tostring(value)
                box.Text = entry.Value
                if info.Callback then task.spawn(info.Callback, entry.Value) end
            end

            return entry
        end

        function group:AddLabel(text)
            open()
            local label = make("TextLabel", {
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                Font = Enum.Font.Gotham,
                TextSize = 15,
                TextColor3 = THEME.dim,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextWrapped = true,
                Text = text,
            })
            place(label)

            return {
                SetText = function(_, newText) label.Text = newText end,
            }
        end

        return group
    end

    -- Tabs --------------------------------------------------------------------

    local pages = {}

    -- The tab you are on turns red and stays red until you pick another, eased
    -- rather than snapped.
    local function selectPage(page, button, name)
        contentHeader.Text = name
        for _, other in ipairs(pages) do
            local active = other.button == button
            other.page.Visible = other.page == page
            tween(other.button, 0.16, {
                BackgroundColor3 = active and THEME.tabOn or THEME.row,
                BackgroundTransparency = active and 0.05 or 0.35,
                TextColor3 = active and THEME.text or THEME.accent,
            })
        end
    end

    function newTab(name)
        local page = make("ScrollingFrame", {
            Position = UDim2.fromOffset(0, 30),
            Size = UDim2.new(1, 0, 1, -30),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = THEME.accent,
            CanvasSize = UDim2.new(),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            Visible = false,
        }, contentHolder)
        padding(page, 10)
        make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, page)

        local button = round(make("TextButton", {
            Size = UDim2.new(1, 0, 0, 33),
            BackgroundColor3 = THEME.row,
            BackgroundTransparency = 0.35,
            Font = Enum.Font.GothamBold,
            TextSize = 24,
            TextColor3 = THEME.accent,
            Text = name,
            TextXAlignment = Enum.TextXAlignment.Left,
            AutoButtonColor = false,
            LayoutOrder = #pages + 1,
        }, sidebar), 9)
        edge(button, THEME.border, 0.6)
        make("UIPadding", { PaddingLeft = UDim.new(0, 10) }, button)

        table.insert(pages, { page = page, button = button })
        button.MouseButton1Click:Connect(function()
            selectPage(page, button, name)
        end)

        if #pages == 1 then selectPage(page, button, name) end

        local state = { current = nil, order = 1 }
        return {
            AddLeftGroupbox  = function(_, title) return newGroup(page, state, title) end,
            AddRightGroupbox = function(_, title) return newGroup(page, state, title) end,
        }
    end

    -- Live readouts -----------------------------------------------------------

    do
        local frames, elapsed, since = 0, 0, 0

        Master:Add(RunService.RenderStepped:Connect(function(dt)
            frames += 1
            elapsed += dt
            since += dt

            if elapsed >= 0.5 then
                fpsLabel.Text = ("%d fps"):format(math.floor(frames / elapsed + 0.5))
                frames, elapsed = 0, 0
            end

            if since >= 1 then
                since = 0
                local ok, value = pcall(function()
                    return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
                end)
                pingLabel.Text = (ok and value) and ("%d ms"):format(math.floor(value + 0.5)) or "-- ms"
            end
        end))
    end

    -- Handed to the rest of the file.
    UI = {
        notify = showNotification,
        destroy = function()
            -- The cursor goes back to how the game had it even if the menu is
            -- unloaded while open.
            pcall(freeCursor, false)
            pcall(function() screen:Destroy() end)
        end,
        setShown = setShown,
    }
end

