-- Plain buttons, not toggles: pressing a teleport twice should take you there
-- twice, not bounce you back. "< Return" is the way back.
local function buildTeleports(group, spots)
    for _, spot in ipairs(spots) do
        Button(group, "TP: " .. spot.name, "Teleport to " .. spot.name, function()
            pushPosition()
            pivotTo(spot.cf)
            notify("Teleported to " .. spot.name)
        end)
    end

    Button(group, "< Return", "Go back to your previous position", function()
        if popPosition() then
            notify("Returned to previous position")
        else
            notify("No saved position to return to.")
        end
    end)
end

buildTeleports(N1TPGroup, NIGHT1_SPOTS)
buildTeleports(N2TPGroup, NIGHT2_SPOTS)
buildTeleports(BunkerTPGroup, BUNKER_SPOTS)

local baseWalkSpeed = 16
local baseJumpPower = 50

local function captureBaseStats()
    local hum = Char.humanoid()
    if not hum then return end
    if hum.WalkSpeed > 0 and hum.WalkSpeed < 100 then
        baseWalkSpeed = hum.WalkSpeed
    end
    if hum.UseJumpPower and hum.JumpPower > 0 and hum.JumpPower < 200 then
        baseJumpPower = hum.JumpPower
    end
end

