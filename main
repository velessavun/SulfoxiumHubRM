local mutedSounds = {}

ToggleButton(UtilityGroup, "Mute All Game Sounds",
    "Silences every SoundGroup and loose Sound — press again to bring the volume back",
    function()
        local muted = 0
        for _, inst in ipairs(game:GetDescendants()) do
            if inst:IsA("Sound") and inst.Volume > 0 then
                table.insert(mutedSounds, { inst = inst, volume = inst.Volume })
                inst.Volume = 0
                muted += 1
            end
        end
        notify(("Muted %d sound(s)."):format(muted))
    end,
    function()
