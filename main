    "Point the camera at the selected player — press again to return the camera",
    function()
        local name = opt("PlayerList")
        local target = name and Players:FindFirstChild(name)
        local hum = target and target.Character and target.Character:FindFirstChildOfClass("Humanoid")
        local camera = Workspace.CurrentCamera
        if not hum or not camera then
            notify("That player has no character right now.")
            return false
